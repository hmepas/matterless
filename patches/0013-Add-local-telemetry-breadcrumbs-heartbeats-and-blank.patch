+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {
+    addBreadcrumb,
+    getBreadcrumbs,
+    installTelemetryMonitors,
+    reportTelemetry,
+    resetTelemetryForTests,
+} from './telemetry';
+
+describe('utils/telemetry', () => {
+    const originalFetch = window.fetch;
+    let cleanup: (() => void) | null = null;
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        resetTelemetryForTests();
+        document.body.innerHTML = '<div id="root"></div>';
+        window.history.pushState({}, '', '/team/channels/town-square');
+    });
+
+    afterEach(() => {
+        cleanup?.();
+        cleanup = null;
+        jest.useRealTimers();
+        window.fetch = originalFetch;
+        document.body.innerHTML = '';
+    });
+
+    test('caps breadcrumbs at 40 and strips query strings from routes', () => {
+        for (let i = 0; i < 45; i++) {
+            addBreadcrumb('route', `nav-${i}`, {route: `/team/channels/c${i}?token=secret`});
+        }
+        const crumbs = getBreadcrumbs();
+        expect(crumbs).toHaveLength(40);
+        expect(crumbs[0].msg).toBe('nav-5');
+        expect(crumbs[crumbs.length - 1].route).toBe('/team/channels/c44');
+    });
+
+    test('sends stack frames, component_stack, dom summary, and breadcrumbs to /__telemetry', () => {
+        const fetchMock = jest.fn().mockResolvedValue({ok: true, status: 204});
+        window.fetch = fetchMock as unknown as typeof fetch;
+        document.body.innerHTML = '<div id="root"><div>hello</div></div>';
+
+        addBreadcrumb('ws', 'ws_close code=1006');
+        const err = new Error('boom');
+        err.stack = 'Error: boom\n    at render (http://localhost:9005/static/main.abc.js?secret=1:10:2)';
+
+        reportTelemetry('react_crash', {
+            error: err,
+            component: 'CenterChannel',
+            componentStack: '\n    in CenterChannel\n    in Root',
+            route: '/team/channels/town-square?secret=1',
+        });
+
+        expect(fetchMock).toHaveBeenCalledTimes(1);
+        const [url, init] = fetchMock.mock.calls[0];
+        expect(url).toBe('/__telemetry');
+        const body = JSON.parse(init.body as string);
+        expect(body.event).toBe('react_crash');
+        expect(body.component).toBe('CenterChannel');
+        expect(body.route).toBe('/team/channels/town-square');
+        expect(body.error.name).toBe('Error');
+        expect(body.error.message).toBe('boom');
+        expect(body.error.stack[1]).toBe('at render (http://localhost:9005/static/main.abc.js:10:2)');
+        expect(body.error.component_stack).toEqual(['in CenterChannel', 'in Root']);
+        expect(body.dom).toEqual({root_children: 1, root_text_len: 5, loading_visible: false});
+        expect(body.breadcrumbs[0].msg).toBe('ws_close code=1006');
+    });
+
+    test('blank-screen watchdog fires when #root stays empty and stays quiet when content renders', () => {
+        const fetchMock = jest.fn().mockResolvedValue({ok: true, status: 204});
+        window.fetch = fetchMock as unknown as typeof fetch;
+
+        cleanup = installTelemetryMonitors({
+            getWsState: () => 'closed',
+            getStoreSummary: () => ({has_current_user: true, teams_count: 1, has_channel: false}),
+        });
+
+        jest.advanceTimersByTime(12000);
+
+        const blankCalls = fetchMock.mock.calls.filter(([, init]) => JSON.parse(init.body as string).event === 'blank_screen');
+        expect(blankCalls).toHaveLength(1);
+        const payload = JSON.parse(blankCalls[0][1].body as string);
+        expect(payload.ws_state).toBe('closed');
+        expect(payload.dom).toEqual({
+            root_children: 0,
+            root_text_len: 0,
+            loading_visible: false,
+            has_current_user: true,
+            teams_count: 1,
+            has_channel: false,
+        });
+
+        // Once content renders, focus should not trigger another blank_screen report.
+        document.body.innerHTML = '<div id="root"><div>Loaded channel content</div></div>';
+        jest.advanceTimersByTime(31000);
+        window.dispatchEvent(new Event('focus'));
+        jest.advanceTimersByTime(8000);
+
+        const blankCallsAfter = fetchMock.mock.calls.filter(([, init]) => JSON.parse(init.body as string).event === 'blank_screen');
+        expect(blankCallsAfter).toHaveLength(1);
+    });
+
+    test('wraps fetch to record failed API requests without recursing on /__telemetry', async () => {
+        const fetchMock = jest.fn().mockResolvedValue({ok: false, status: 502});
+        window.fetch = fetchMock as unknown as typeof fetch;
+
+        cleanup = installTelemetryMonitors();
+
+        await window.fetch('/api/v4/users/me?token=secret', {method: 'GET'});
+
+        const httpCrumb = getBreadcrumbs().find((c) => c.cat === 'http');
+        expect(httpCrumb).toBeDefined();
+        expect(httpCrumb?.msg).toBe('GET /api/v4/users/me');
+        expect(httpCrumb?.status).toBe(502);
+    });
+
+    test('manual snapshot hotkey sends manual_snapshot event immediately', () => {
+        const fetchMock = jest.fn().mockResolvedValue({ok: true, status: 204});
+        window.fetch = fetchMock as unknown as typeof fetch;
+
+        cleanup = installTelemetryMonitors();
+        window.dispatchEvent(new KeyboardEvent('keydown', {key: 'd', ctrlKey: true, shiftKey: true, altKey: true}));
+
+        const manualCalls = fetchMock.mock.calls.filter(([, init]) => JSON.parse(init.body as string).event === 'manual_snapshot');
+        expect(manualCalls).toHaveLength(1);
+    });
+});
