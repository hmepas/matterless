@@ -0,0 +1,440 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): lightweight local telemetry ("mini-Sentry") that records safe diagnostic
+// breadcrumbs, stack traces, heartbeats, and blank-screen watchdog snapshots to the local proxy
+// (POST /__telemetry) without ever capturing message bodies, cookies, tokens, or query strings.
+
+export type Breadcrumb = {
+    ts: string;
+    cat: string;
+    msg: string;
+    route?: string;
+    status?: number;
+    ms?: number;
+};
+
+export type TelemetryDomSummary = {
+    root_children?: number;
+    root_text_len?: number;
+    loading_visible?: boolean;
+    has_current_user?: boolean;
+    teams_count?: number;
+    has_channel?: boolean;
+    should_mount_routes?: boolean;
+};
+
+export type TelemetryStoreSummary = Pick<TelemetryDomSummary, 'has_current_user' | 'teams_count' | 'has_channel'>;
+
+export type TelemetryErrorPayload = {
+    name?: string;
+    message?: string;
+    stack?: string[];
+    component_stack?: string[];
+};
+
+export type TelemetryMonitorOptions = {
+    getStoreSummary?: () => TelemetryStoreSummary;
+    getWsState?: () => string;
+    listenHistory?: (listener: (location: {pathname: string}) => void) => () => void;
+};
+
+const MAX_BREADCRUMBS = 40;
+const ERROR_DEDUP_MS = 10000;
+const SLOW_FETCH_MS = 5000;
+const BLANK_SCREEN_BOOT_DELAY_MS = 12000;
+const BLANK_SCREEN_NAV_DELAY_MS = 8000;
+const BLANK_SCREEN_COOLDOWN_MS = 30000;
+const HEARTBEAT_INTERVAL_MS = 5 * 60 * 1000;
+
+const BLANK_SCREEN_IGNORED_PREFIXES = [
+    '/login',
+    '/__auth',
+    '/signup',
+    '/landing',
+    '/error',
+    '/mfa',
+    '/reset_password',
+    '/access_problem',
+];
+
+let tabId = generateTabId();
+let startedAt = Date.now();
+const breadcrumbs: Breadcrumb[] = [];
+const recentEvents = new Map<string, number>();
+let lastBlankScreenReportAt = 0;
+
+let installed = false;
+let nativeFetch: typeof fetch | null = null;
+let storeSummaryGetter: (() => TelemetryStoreSummary) | undefined;
+let wsStateGetter: (() => string) | undefined;
+
+function generateTabId(): string {
+    return Math.random().toString(16).slice(2, 10).padEnd(8, '0');
+}
+
+function sanitizePath(raw: string): string {
+    if (!raw) {
+        return '';
+    }
+    try {
+        if (raw.startsWith('http://') || raw.startsWith('https://')) {
+            return new URL(raw).pathname.slice(0, 160);
+        }
+    } catch {
+        // Fall through to string splitting.
+    }
+    return raw.split(/[?#]/, 1)[0].slice(0, 160);
+}
+
+function sanitizeLine(raw: string, maxLen: number): string {
+    return raw.
+        replace(/[\r\n\t]+/g, ' ').
+        replace(/\?[^\s):\]"']*/g, '').
+        trim().
+        slice(0, maxLen);
+}
+
+function detectBundleId(): string | undefined {
+    if (typeof document === 'undefined') {
+        return undefined;
+    }
+    const script = document.querySelector<HTMLScriptElement>('script[src*="/static/main."]');
+    const src = script?.getAttribute('src');
+    if (!src) {
+        return undefined;
+    }
+    const clean = sanitizePath(src);
+    const parts = clean.split('/');
+    return parts[parts.length - 1] || undefined;
+}
+
+function buildErrorPayload(error: unknown, componentStack?: string): TelemetryErrorPayload | undefined {
+    const payload: TelemetryErrorPayload = {};
+
+    if (error instanceof Error) {
+        payload.name = sanitizeLine(error.name || 'Error', 80);
+        payload.message = sanitizeLine(error.message || '', 240);
+        if (error.stack) {
+            payload.stack = error.stack.
+                split('\n').
+                map((line) => sanitizeLine(line, 200)).
+                filter(Boolean).
+                slice(0, 12);
+        }
+    } else if (error && typeof error === 'object') {
+        const obj = error as {name?: unknown; message?: unknown; server_error_id?: unknown; status_code?: unknown; stack?: unknown};
+        if (obj.name) {
+            payload.name = sanitizeLine(String(obj.name), 80);
+        }
+        const msgParts = [obj.server_error_id, obj.status_code, obj.message].filter((v) => v !== undefined && v !== '');
+        if (msgParts.length > 0) {
+            payload.message = sanitizeLine(msgParts.map(String).join(':'), 240);
+        }
+        if (typeof obj.stack === 'string') {
+            payload.stack = obj.stack.
+                split('\n').
+                map((line) => sanitizeLine(line, 200)).
+                filter(Boolean).
+                slice(0, 12);
+        }
+    } else if (error !== undefined && error !== null && error !== '') {
+        payload.message = sanitizeLine(String(error), 240);
+    }
+
+    if (componentStack) {
+        const frames = componentStack.
+            split('\n').
+            map((line) => sanitizeLine(line, 120)).
+            filter(Boolean).
+            slice(0, 12);
+        if (frames.length > 0) {
+            payload.component_stack = frames;
+        }
+    }
+
+    return Object.keys(payload).length > 0 ? payload : undefined;
+}
+
+export function collectDomSummary(): TelemetryDomSummary {
+    const summary: TelemetryDomSummary = {};
+    if (typeof document !== 'undefined') {
+        const root = document.getElementById('root');
+        summary.root_children = root ? root.children.length : 0;
+        summary.root_text_len = root ? (root.textContent ?? '').trim().length : 0;
+
+        const loadingEl = document.getElementById('initialPageLoadingScreen');
+        summary.loading_visible = Boolean(
+            loadingEl &&
+            !loadingEl.classList.contains('fade-out') &&
+            loadingEl.style.display !== 'none',
+        );
+    }
+    if (storeSummaryGetter) {
+        try {
+            const storeSummary = storeSummaryGetter();
+            if (typeof storeSummary.has_current_user === 'boolean') {
+                summary.has_current_user = storeSummary.has_current_user;
+            }
+            if (typeof storeSummary.teams_count === 'number') {
+                summary.teams_count = storeSummary.teams_count;
+            }
+            if (typeof storeSummary.has_channel === 'boolean') {
+                summary.has_channel = storeSummary.has_channel;
+            }
+        } catch {
+            // Never let diagnostic inspection throw.
+        }
+    }
+    return summary;
+}
+
+export function addBreadcrumb(
+    cat: string,
+    msg: string,
+    extra: {route?: string; status?: number; ms?: number} = {},
+): void {
+    const crumb: Breadcrumb = {
+        ts: new Date().toISOString(),
+        cat: sanitizeLine(cat, 32),
+        msg: sanitizeLine(msg, 140),
+    };
+    if (extra.route) {
+        crumb.route = sanitizePath(extra.route);
+    }
+    if (typeof extra.status === 'number' && Number.isFinite(extra.status)) {
+        crumb.status = Math.round(extra.status);
+    }
+    if (typeof extra.ms === 'number' && Number.isFinite(extra.ms)) {
+        crumb.ms = Math.round(extra.ms);
+    }
+    breadcrumbs.push(crumb);
+    if (breadcrumbs.length > MAX_BREADCRUMBS) {
+        breadcrumbs.shift();
+    }
+}
+
+export function getBreadcrumbs(): Breadcrumb[] {
+    return breadcrumbs.slice();
+}
+
+export function reportTelemetry(
+    event: string,
+    options: {
+        error?: unknown;
+        component?: string;
+        componentStack?: string;
+        route?: string;
+        maxBreadcrumbs?: number;
+        deduplicate?: boolean;
+    } = {},
+): void {
+    const errorPayload = buildErrorPayload(options.error, options.componentStack);
+    const component = options.component ?? '';
+    const route = sanitizePath(options.route ?? (typeof window !== 'undefined' ? window.location.pathname : ''));
+
+    if (options.deduplicate !== false) {
+        const key = `${event}|${component}|${errorPayload?.name ?? ''}|${errorPayload?.message ?? ''}`;
+        const now = Date.now();
+        const prev = recentEvents.get(key);
+        if (prev !== undefined && now - prev < ERROR_DEDUP_MS) {
+            return;
+        }
+        recentEvents.set(key, now);
+    }
+
+    const fetchFn = nativeFetch ?? (typeof fetch === 'function' ? fetch : null);
+    if (!fetchFn) {
+        return;
+    }
+
+    const maxCrumbs = options.maxBreadcrumbs ?? MAX_BREADCRUMBS;
+    const payload = {
+        event,
+        tab_id: tabId,
+        bundle_id: detectBundleId(),
+        route,
+        component: component || undefined,
+        online: typeof navigator !== 'undefined' ? navigator.onLine : true,
+        visibility: typeof document !== 'undefined' ? document.visibilityState : undefined,
+        ws_state: wsStateGetter ? wsStateGetter() : undefined,
+        uptime_s: Math.max(0, Math.round((Date.now() - startedAt) / 1000)),
+        error: errorPayload,
+        dom: collectDomSummary(),
+        breadcrumbs: maxCrumbs > 0 ? breadcrumbs.slice(-maxCrumbs) : undefined,
+    };
+
+    try {
+        fetchFn('/__telemetry', {
+            method: 'POST',
+            headers: {'Content-Type': 'application/json'},
+            keepalive: true,
+            body: JSON.stringify(payload),
+        }).catch(() => {
+            // Telemetry must never break the application.
+        });
+    } catch {
+        // Ignore synchronous fetch mock errors.
+    }
+}
+
+function isIgnoredBlankScreenRoute(pathname: string): boolean {
+    return BLANK_SCREEN_IGNORED_PREFIXES.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
+}
+
+export function installTelemetryMonitors(options: TelemetryMonitorOptions = {}): () => void {
+    storeSummaryGetter = options.getStoreSummary;
+    wsStateGetter = options.getWsState;
+
+    if (installed || typeof window === 'undefined') {
+        return () => {};
+    }
+    installed = true;
+
+    let blankScreenTimer: ReturnType<typeof setTimeout> | null = null;
+
+    const checkBlankScreen = () => {
+        blankScreenTimer = null;
+        if (typeof document !== 'undefined' && document.visibilityState === 'hidden') {
+            return;
+        }
+        const pathname = sanitizePath(window.location.pathname);
+        if (isIgnoredBlankScreenRoute(pathname)) {
+            return;
+        }
+        const dom = collectDomSummary();
+        const looksBlank = (dom.root_text_len === 0 && !dom.loading_visible) || Boolean(dom.loading_visible);
+        if (!looksBlank) {
+            return;
+        }
+        const now = Date.now();
+        if (now - lastBlankScreenReportAt < BLANK_SCREEN_COOLDOWN_MS) {
+            return;
+        }
+        lastBlankScreenReportAt = now;
+        addBreadcrumb('watchdog', `blank_screen text_len=${dom.root_text_len ?? 0} loading=${Boolean(dom.loading_visible)}`);
+        reportTelemetry('blank_screen', {deduplicate: false});
+    };
+
+    const scheduleBlankScreenCheck = (delayMs: number) => {
+        if (blankScreenTimer) {
+            clearTimeout(blankScreenTimer);
+        }
+        blankScreenTimer = setTimeout(checkBlankScreen, delayMs);
+    };
+
+    const onOnline = () => {
+        addBreadcrumb('net', 'online');
+        scheduleBlankScreenCheck(BLANK_SCREEN_NAV_DELAY_MS);
+        reportTelemetry('heartbeat', {maxBreadcrumbs: 12, deduplicate: false});
+    };
+
+    const onOffline = () => {
+        addBreadcrumb('net', 'offline');
+        reportTelemetry('heartbeat', {maxBreadcrumbs: 12, deduplicate: false});
+    };
+
+    const onFocus = () => {
+        addBreadcrumb('ui', 'focus');
+        scheduleBlankScreenCheck(BLANK_SCREEN_NAV_DELAY_MS);
+    };
+
+    const onVisibilityChange = () => {
+        const state = typeof document !== 'undefined' ? document.visibilityState : 'unknown';
+        addBreadcrumb('ui', `visibility:${state}`);
+        if (state === 'visible') {
+            scheduleBlankScreenCheck(BLANK_SCREEN_NAV_DELAY_MS);
+        }
+    };
+
+    const onKeyDown = (event: KeyboardEvent) => {
+        if ((event.ctrlKey || event.metaKey) && event.shiftKey && event.altKey && event.key.toLowerCase() === 'd') {
+            addBreadcrumb('ui', 'manual_snapshot');
+            reportTelemetry('manual_snapshot', {deduplicate: false});
+        }
+    };
+
+    window.addEventListener('online', onOnline);
+    window.addEventListener('offline', onOffline);
+    window.addEventListener('focus', onFocus);
+    window.addEventListener('keydown', onKeyDown);
+    if (typeof document !== 'undefined') {
+        document.addEventListener('visibilitychange', onVisibilityChange);
+    }
+
+    const unlistenHistory = options.listenHistory?.((location) => {
+        const route = sanitizePath(location.pathname);
+        addBreadcrumb('route', route, {route});
+        scheduleBlankScreenCheck(BLANK_SCREEN_NAV_DELAY_MS);
+    });
+
+    const originalFetch = typeof window.fetch === 'function' ? window.fetch.bind(window) : null;
+    if (originalFetch) {
+        nativeFetch = originalFetch;
+        window.fetch = ((input: RequestInfo | URL, init?: RequestInit) => {
+            const rawUrl = typeof input === 'string' ? input : (input instanceof URL ? input.toString() : input.url);
+            const pathname = sanitizePath(rawUrl);
+            if (pathname === '/__telemetry' || pathname === '/__client_log') {
+                return originalFetch(input, init);
+            }
+            const method = (init?.method || (typeof input !== 'string' && !(input instanceof URL) ? input.method : 'GET') || 'GET').toUpperCase();
+            const reqStarted = Date.now();
+            return originalFetch(input, init).then(
+                (response) => {
+                    const ms = Date.now() - reqStarted;
+                    if (!response.ok || ms >= SLOW_FETCH_MS) {
+                        addBreadcrumb('http', `${method} ${pathname}`, {status: response.status, ms});
+                    }
+                    return response;
+                },
+                (err) => {
+                    const ms = Date.now() - reqStarted;
+                    addBreadcrumb('http', `${method} ${pathname} network_error`, {status: 0, ms});
+                    throw err;
+                },
+            );
+        }) as typeof fetch;
+    }
+
+    const heartbeatTimer = setInterval(() => {
+        if (typeof document === 'undefined' || document.visibilityState === 'visible') {
+            reportTelemetry('heartbeat', {maxBreadcrumbs: 10, deduplicate: false});
+        }
+    }, HEARTBEAT_INTERVAL_MS);
+
+    addBreadcrumb('app', 'telemetry_installed', {route: window.location.pathname});
+    scheduleBlankScreenCheck(BLANK_SCREEN_BOOT_DELAY_MS);
+
+    return () => {
+        installed = false;
+        if (blankScreenTimer) {
+            clearTimeout(blankScreenTimer);
+            blankScreenTimer = null;
+        }
+        clearInterval(heartbeatTimer);
+        window.removeEventListener('online', onOnline);
+        window.removeEventListener('offline', onOffline);
+        window.removeEventListener('focus', onFocus);
+        window.removeEventListener('keydown', onKeyDown);
+        if (typeof document !== 'undefined') {
+            document.removeEventListener('visibilitychange', onVisibilityChange);
+        }
+        unlistenHistory?.();
+        if (originalFetch) {
+            window.fetch = originalFetch;
+            nativeFetch = null;
+        }
+    };
+}
+
+export function resetTelemetryForTests(): void {
+    breadcrumbs.length = 0;
+    recentEvents.clear();
+    lastBlankScreenReportAt = 0;
+    tabId = generateTabId();
+    startedAt = Date.now();
+    installed = false;
+    nativeFetch = null;
+    storeSummaryGetter = undefined;
+    wsStateGetter = undefined;
+}
