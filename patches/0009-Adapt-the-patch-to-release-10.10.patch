index 00000000..025d6a06
--- /dev/null
+++ b/webapp/channels/src/utils/use_external_store.ts
@@ -0,0 +1,26 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {useEffect, useReducer, useRef} from 'react';
+
+// PATCH(all-teams): React 17 lacks useSyncExternalStore. This covers what the patch needs from it:
+// read the snapshot on render, re-render when a store notification changes it.
+export function useSyncExternalStore<T>(subscribe: (onChange: () => void) => () => void, getSnapshot: () => T): T {
+    const [, rerender] = useReducer((n: number) => n + 1, 0);
+    const value = getSnapshot();
+    const rendered = useRef(value);
+    rendered.current = value;
+
+    useEffect(() => {
+        const check = () => {
+            if (!Object.is(getSnapshot(), rendered.current)) {
+                rerender();
+            }
+        };
+        const unsubscribe = subscribe(check);
+        check(); // the store may have changed between render and subscribe
+        return unsubscribe;
+    }, [subscribe, getSnapshot]);
+
+    return value;
+}
