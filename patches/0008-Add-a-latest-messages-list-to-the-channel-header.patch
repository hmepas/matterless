--- /dev/null
+++ b/webapp/channels/src/actions/views/channel_latest.ts
@@ -0,0 +1,60 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {batchActions} from 'redux-batched-actions';
+
+import {SearchTypes} from 'mattermost-redux/action_types';
+import {getMentionsAndStatusesForPosts, receivedPosts} from 'mattermost-redux/actions/posts';
+import {Client4} from 'mattermost-redux/client';
+import {getCurrentTeamId} from 'mattermost-redux/selectors/entities/teams';
+
+import {getPreviousRhsState, getRhsState, getSelectedChannelId} from 'selectors/rhs';
+
+import {ActionTypes, RHSStates} from 'utils/constants';
+
+import type {ActionFuncAsync} from 'types/store';
+
+export const LATEST_POSTS_COUNT = 60;
+
+// Shows the channel's latest messages in the right panel: root posts and replies to any thread,
+// followed or not, newest first. It reuses the pinned messages list, which already renders a flat
+// list of one channel's posts with jump and reply.
+export function showChannelLatest(channelId: string): ActionFuncAsync<boolean> {
+    return async (dispatch, getState) => {
+        const state = getState();
+        let previousRhsState = getRhsState(state);
+        if (previousRhsState === RHSStates.CHANNEL_LATEST) {
+            previousRhsState = getPreviousRhsState(state);
+        }
+        dispatch({type: ActionTypes.UPDATE_RHS_STATE, channelId, state: RHSStates.CHANNEL_LATEST, previousRhsState});
+
+        // The list shares the pinned posts' loading flag, so its spinner covers the previous results.
+        dispatch({type: SearchTypes.SEARCH_PINNED_POSTS_REQUEST});
+        let posts;
+        try {
+            posts = await Client4.getPosts(channelId, 0, LATEST_POSTS_COUNT, false, false);
+            await getMentionsAndStatusesForPosts(posts.posts, dispatch, getState);
+        } catch (error) {
+            dispatch({type: SearchTypes.SEARCH_PINNED_POSTS_FAILURE, error});
+            return {error};
+        }
+
+        // The panel may have moved on while the posts were loading: stop the spinner. If it moved to
+        // another channel, that channel's own load is running and will finish it.
+        if (getRhsState(getState()) !== RHSStates.CHANNEL_LATEST) {
+            dispatch({type: SearchTypes.SEARCH_PINNED_POSTS_SUCCESS});
+            return {data: false};
+        }
+        if (getSelectedChannelId(getState()) !== channelId) {
+            return {data: false};
+        }
+
+        dispatch(batchActions([
+            receivedPosts(posts),
+            {type: SearchTypes.RECEIVED_SEARCH_POSTS, data: {order: posts.order, posts: posts.posts}},
+            {type: SearchTypes.RECEIVED_SEARCH_TERM, data: {teamId: getCurrentTeamId(state), terms: null, isOrSearch: false}},
+            {type: SearchTypes.SEARCH_PINNED_POSTS_SUCCESS},
+        ]));
+        return {data: true};
+    };
+}
