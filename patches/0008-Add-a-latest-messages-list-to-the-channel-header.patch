+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import type {PostList} from '@mattermost/types/posts';
+
+import {SearchTypes} from 'mattermost-redux/action_types';
+import {Client4} from 'mattermost-redux/client';
+
+import {ActionTypes, RHSStates} from 'utils/constants';
+
+import type {GlobalState} from 'types/store';
+
+import {LATEST_POSTS_COUNT, showChannelLatest} from './channel_latest';
+
+jest.mock('mattermost-redux/actions/posts', () => ({
+    receivedPosts: (posts: unknown) => ({type: 'RECEIVED_POSTS', data: posts}),
+    getMentionsAndStatusesForPosts: jest.fn(() => Promise.resolve()),
+}));
+
+// A root post and a reply to an older thread, as the server returns them: newest first.
+const posts: PostList = {
+    order: ['reply', 'root'],
+    posts: {
+        reply: {id: 'reply', channel_id: 'ch1', root_id: 'old_thread', create_at: 2},
+        root: {id: 'root', channel_id: 'ch1', root_id: '', create_at: 1},
+    },
+} as unknown as PostList;
+
+type Rhs = {rhsState: string | null; previousRhsStates: string[]; selectedChannelId: string};
+
+function setup(rhs: Partial<Rhs> = {}) {
+    const current: Rhs = {rhsState: null, previousRhsStates: [], selectedChannelId: '', ...rhs};
+    const actions: Array<{type: string; [key: string]: unknown}> = [];
+    const getState = () => ({
+        entities: {teams: {currentTeamId: 't1'}},
+        views: {rhs: current},
+    }) as unknown as GlobalState;
+    const dispatch = (action: {type: string; payload?: unknown[]; [key: string]: unknown}) => {
+        const list = action.type === 'BATCHING_REDUCER.BATCH' ? action.payload as typeof actions : [action];
+        for (const a of list) {
+            actions.push(a);
+            if (a.type === ActionTypes.UPDATE_RHS_STATE) {
+                current.rhsState = a.state as string;
+                current.selectedChannelId = a.channelId as string;
+            }
+        }
+        return action;
+    };
+    const run = (channelId: string) => showChannelLatest(channelId)(dispatch as never, getState, {} as never);
+    const types = () => actions.map((a) => a.type);
+    const searchResults = () => actions.find((a) => a.type === SearchTypes.RECEIVED_SEARCH_POSTS)?.data;
+    return {current, actions, run, types, searchResults};
+}
+
+describe('latest messages of a channel', () => {
+    afterEach(() => jest.restoreAllMocks());
+
+    test('lists the latest messages, replies to any thread included, newest first', async () => {
+        const getPosts = jest.spyOn(Client4, 'getPosts').mockResolvedValue(posts);
+        const {run, searchResults} = setup();
+
+        await run('ch1');
+
+        // Without collapsed threads the server returns replies as channel posts.
+        expect(getPosts).toHaveBeenCalledWith('ch1', 0, LATEST_POSTS_COUNT, false, false);
+        expect(searchResults()).toEqual({order: ['reply', 'root'], posts: posts.posts});
+    });
+
+    test('opens the panel for that channel before the messages arrive', async () => {
+        let resolve: (value: PostList) => void = () => {};
+        jest.spyOn(Client4, 'getPosts').mockReturnValue(new Promise((r) => {
+            resolve = r;
+        }));
+        const {current, run, types} = setup();
+
+        const done = run('ch1');
+        expect(current).toMatchObject({rhsState: RHSStates.CHANNEL_LATEST, selectedChannelId: 'ch1'});
+        expect(types()).toContain(SearchTypes.SEARCH_PINNED_POSTS_REQUEST);
+
+        resolve(posts);
+        await done;
+        expect(types()).toContain(SearchTypes.SEARCH_PINNED_POSTS_SUCCESS);
+    });
+
+    test('opening it again keeps the panel that was there before for the back button', async () => {
+        jest.spyOn(Client4, 'getPosts').mockResolvedValue(posts);
+        const {actions, run} = setup({rhsState: RHSStates.CHANNEL_LATEST, previousRhsStates: [RHSStates.CHANNEL_INFO], selectedChannelId: 'ch0'});
+
+        await run('ch1');
+
+        expect(actions.find((a) => a.type === ActionTypes.UPDATE_RHS_STATE)?.previousRhsState).toBe(RHSStates.CHANNEL_INFO);
+    });
+
+    test('messages that arrive after the panel switched to something else are dropped', async () => {
+        let resolve: (value: PostList) => void = () => {};
+        jest.spyOn(Client4, 'getPosts').mockReturnValue(new Promise((r) => {
+            resolve = r;
+        }));
+        const {current, run, searchResults, types} = setup();
+
+        const done = run('ch1');
+        current.rhsState = RHSStates.PIN;
+        resolve(posts);
+        await done;
+
+        expect(searchResults()).toBeUndefined();
+        expect(types()).toContain(SearchTypes.SEARCH_PINNED_POSTS_SUCCESS);
+    });
+
+    test('messages of the previous channel never replace the list of the new one', async () => {
+        let resolve: (value: PostList) => void = () => {};
+        jest.spyOn(Client4, 'getPosts').mockReturnValue(new Promise((r) => {
+            resolve = r;
+        }));
+        const {current, run, searchResults} = setup();
+
+        const done = run('ch1');
+        current.selectedChannelId = 'ch2';
+        resolve(posts);
+        await done;
+
+        expect(searchResults()).toBeUndefined();
+    });
+
+    test('a failed load stops the spinner', async () => {
+        jest.spyOn(Client4, 'getPosts').mockRejectedValue(new Error('offline'));
+        const {run, types} = setup();
+
+        const result = await run('ch1');
+
+        expect(result).toHaveProperty('error');
+        expect(types()).toContain(SearchTypes.SEARCH_PINNED_POSTS_FAILURE);
+    });
+});
diff --git a/webapp/channels/src/actions/views/channel_latest.ts b/webapp/channels/src/actions/views/channel_latest.ts
