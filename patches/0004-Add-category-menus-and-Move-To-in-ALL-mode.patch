+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): "Move to..." listing the categories of the ALL pseudo-team.
+
+import React from 'react';
+import {FormattedMessage} from 'react-intl';
+import {useDispatch, useSelector} from 'react-redux';
+
+import {
+    CheckIcon,
+    ChevronRightIcon,
+    FolderMoveOutlineIcon,
+    FolderOutlineIcon,
+} from '@mattermost/compass-icons/components';
+import type {Channel} from '@mattermost/types/channels';
+
+import {General} from 'mattermost-redux/constants';
+import {getAllChannels} from 'mattermost-redux/selectors/entities/channels';
+
+import {clearChannelSelection} from 'actions/views/channel_sidebar';
+
+import * as Menu from 'components/menu';
+
+import {
+    assignChannels,
+    canGroupHold,
+    findGroupId,
+    getAllTeamsLayout,
+    requestNewGroup,
+    setAllTeamsLayout,
+    useAllTeamsLayout,
+} from 'utils/all_teams_mode';
+
+import type {GlobalState} from 'types/store';
+
+type Props = {
+    channel: Channel;
+    inHeaderDropdown?: boolean;
+};
+
+const isDmChannel = (channel?: Channel) => channel?.type === General.DM_CHANNEL || channel?.type === General.GM_CHANNEL;
+
+export default function AllTeamsMoveToSubMenu({channel, inHeaderDropdown}: Props) {
+    const dispatch = useDispatch();
+    const layout = useAllTeamsLayout();
+    const allChannels = useSelector(getAllChannels);
+    const multiSelectedIds = useSelector((state: GlobalState) => state.views.channelSidebar.multiSelectedChannelIds);
+
+    // As in the native menu, opening it on a selected channel acts on the whole selection.
+    const channelIds = !inHeaderDropdown && multiSelectedIds.includes(channel.id) ? multiSelectedIds : [channel.id];
+    const currentGroupId = findGroupId(layout, channel.id, isDmChannel(channel));
+
+    const moveTo = (groupId: string) => {
+        setAllTeamsLayout(assignChannels(getAllTeamsLayout(), channelIds, groupId));
+        dispatch(clearChannelSelection());
+    };
+
+    const moveToNewCategory = () => {
+        requestNewGroup(channelIds);
+        dispatch(clearChannelSelection());
+    };
+
+    const groups = layout.groups.filter((group) => channelIds.every((id) => canGroupHold(group.id, isDmChannel(allChannels[id]))));
+
+    return (
+        <Menu.SubMenu
+            id={`moveTo-${channel.id}`}
+            labels={
+                <FormattedMessage
+                    id='sidebar_left.sidebar_channel_menu.moveTo'
+                    defaultMessage='Move to...'
+                />
+            }
+            leadingElement={inHeaderDropdown ? null : <FolderMoveOutlineIcon size={18}/>}
+            trailingElements={<ChevronRightIcon size={16}/>}
+            menuId={`moveTo-${channel.id}-menu`}
+        >
+            {groups.map((group) => (
+                <Menu.Item
+                    id={`moveToCategory-${channel.id}-${group.id}`}
+                    key={group.id}
+                    leadingElement={<FolderOutlineIcon size={18}/>}
+                    labels={<span>{group.name}</span>}
+                    trailingElements={group.id === currentGroupId ? (
+                        <CheckIcon
+                            color='var(--button-bg)'
+                            size={18}
+                        />
+                    ) : null}
+                    onClick={() => moveTo(group.id)}
+                />
+            ))}
+            <Menu.Separator key='moveToDivider'/>
+            <Menu.Item
+                id={`moveToNewCategory-${channel.id}`}
+                key='moveToNewCategory'
+                leadingElement={<FolderMoveOutlineIcon size={18}/>}
+                labels={
+                    <FormattedMessage
+                        id='sidebar_left.sidebar_channel_menu.moveToNewCategory'
+                        defaultMessage='New Category'
+                    />
+                }
+                onClick={moveToNewCategory}
+            />
+        </Menu.SubMenu>
+    );
+}
