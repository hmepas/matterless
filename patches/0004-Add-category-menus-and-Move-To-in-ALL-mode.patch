+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import type {Channel} from '@mattermost/types/channels';
+
+import * as Menu from 'components/menu';
+
+import {fireEvent, renderWithContext, screen, userEvent, waitFor} from 'tests/react_testing_utils';
+import {addGroup, assignChannels, getAllTeamsLayout, makeDefaultLayout, setAllTeamsLayout} from 'utils/all_teams_mode';
+
+import AllTeamsMoveToSubMenu from './all_teams_move_to_sub_menu';
+
+const channel = {id: 'c1', type: 'O', team_id: 't1'} as Channel;
+const dm = {id: 'd1', type: 'D', team_id: ''} as Channel;
+
+function renderMenu(target: Channel, multiSelectedChannelIds: string[] = []) {
+    renderWithContext(
+        <Menu.Container
+            menuButton={{id: 'open', children: 'open'}}
+            menu={{id: 'menu'}}
+        >
+            <AllTeamsMoveToSubMenu channel={target}/>
+        </Menu.Container>,
+        {
+            entities: {channels: {channels: {c1: channel, c2: {...channel, id: 'c2'}, d1: dm}}},
+            views: {channelSidebar: {multiSelectedChannelIds}},
+        } as never,
+    );
+}
+
+async function openSubMenu(target: Channel) {
+    await userEvent.click(document.getElementById('open')!);
+    await waitFor(() => expect(document.getElementById(`moveTo-${target.id}`)).toBeInTheDocument());
+    fireEvent.mouseOver(document.getElementById(`moveTo-${target.id}`)!);
+    await screen.findByText('New Category');
+}
+
+describe('AllTeamsMoveToSubMenu', () => {
+    beforeEach(() => setAllTeamsLayout(addGroup(makeDefaultLayout(), 'g', 'Mine')));
+
+    test('lists ALL categories without Favorites or the DM group, and moves the channel', async () => {
+        renderMenu(channel);
+        await openSubMenu(channel);
+
+        expect(screen.getByText('Mine')).toBeInTheDocument();
+        expect(screen.getByText('Channels')).toBeInTheDocument();
+        expect(screen.queryByText('Direct messages')).not.toBeInTheDocument();
+        expect(screen.queryByText('Favorites')).not.toBeInTheDocument();
+
+        await userEvent.click(screen.getByText('Mine'));
+        await waitFor(() => expect(getAllTeamsLayout().groups[0].channelIds).toEqual(['c1']));
+    });
+
+    test('a DM can go to custom categories and its own group, not to Channels', async () => {
+        setAllTeamsLayout(assignChannels(getAllTeamsLayout(), ['d1'], 'g'));
+        renderMenu(dm);
+        await openSubMenu(dm);
+
+        expect(screen.getByText('Direct messages')).toBeInTheDocument();
+        expect(screen.queryByText('Channels')).not.toBeInTheDocument();
+    });
+
+    test('moves the whole selection when opened on a selected channel', async () => {
+        renderMenu(channel, ['c1', 'c2']);
+        await openSubMenu(channel);
+        await userEvent.click(screen.getByText('Mine'));
+        await waitFor(() => expect(getAllTeamsLayout().groups[0].channelIds).toEqual(['c1', 'c2']));
+    });
+});
