@@ -0,0 +1,198 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): the three-dots menu of a category in the ALL pseudo-team, built on the native one.
+
+import React from 'react';
+import {FormattedMessage} from 'react-intl';
+import {useDispatch, useSelector} from 'react-redux';
+
+import {
+    BellOutlineIcon,
+    CheckIcon,
+    ChevronRightIcon,
+    ClockOutlineIcon,
+    FolderPlusOutlineIcon,
+    FormatListBulletedIcon,
+    PencilOutlineIcon,
+    SortAlphabeticalAscendingIcon,
+    TrashCanOutlineIcon,
+} from '@mattermost/compass-icons/components';
+
+import {readMultipleChannels} from 'mattermost-redux/actions/channels';
+import {getCurrentUserId} from 'mattermost-redux/selectors/entities/common';
+
+import {muteChannel, unmuteChannel} from 'actions/channel_actions';
+import type {AllTeamsShownGroup} from 'selectors/views/all_teams';
+
+import * as Menu from 'components/menu';
+import MarkAsReadMenuItem from 'components/sidebar/sidebar_category/sidebar_category_menu/mark_as_read_menu_item';
+import SidebarCategoryGenericMenu from 'components/sidebar/sidebar_category/sidebar_category_menu/sidebar_category_generic_menu';
+
+import {
+    deleteGroup,
+    DM_GROUP_ID,
+    getAllTeamsLayout,
+    isBuiltInGroup,
+    requestNewGroup,
+    setAllTeamsLayout,
+    setGroupOptions,
+    setGroupSorting,
+} from 'utils/all_teams_mode';
+import type {AllTeamsSorting} from 'utils/all_teams_mode';
+
+type Props = {
+    shownGroup: AllTeamsShownGroup;
+    onRename: () => void;
+};
+
+export default function AllTeamsCategoryMenu({shownGroup, onRename}: Props) {
+    const {group, channelIds, unreadIds, isMuted, unreadFirst} = shownGroup;
+    const dispatch = useDispatch();
+    const currentUserId = useSelector(getCurrentUserId);
+
+    const toggleMute = () => {
+        const action = isMuted ? unmuteChannel : muteChannel;
+        channelIds.forEach((channelId) => dispatch(action(currentUserId, channelId)));
+    };
+
+    const sortItem = (sorting: AllTeamsSorting, label: React.JSX.Element) => (
+        <Menu.Item
+            id={`sort-${sorting}-${group.id}`}
+            key={sorting}
+            labels={label}
+            onClick={() => setAllTeamsLayout(setGroupSorting(getAllTeamsLayout(), group.id, sorting))}
+            trailingElements={group.sorting === sorting ? <CheckIcon size={16}/> : null}
+        />
+    );
+
+    const alphaLabel = (
+        <FormattedMessage
+            id='user.settings.sidebar.sortAlpha'
+            defaultMessage='Alphabetically'
+        />
+    );
+    const recencyLabel = (
+        <FormattedMessage
+            id='sidebar.sortedByRecencyLabel'
+            defaultMessage='Recent activity'
+        />
+    );
+    const manualLabel = (
+        <FormattedMessage
+            id='sidebar.sortedManually'
+            defaultMessage='Manually'
+        />
+    );
+
+    const sortIcons = {
+        alpha: <SortAlphabeticalAscendingIcon size={18}/>,
+        recency: <ClockOutlineIcon size={18}/>,
+        manual: <FormatListBulletedIcon size={18}/>,
+    };
+    const sortLabels = {alpha: alphaLabel, recency: recencyLabel, manual: manualLabel};
+
+    return (
+        <SidebarCategoryGenericMenu
+            id={group.id}
+            name={group.name}
+        >
+            <MarkAsReadMenuItem
+                id={group.id}
+                handleViewCategory={() => dispatch(readMultipleChannels(unreadIds))}
+                numChannels={unreadIds.length}
+            />
+            <Menu.Separator/>
+            {group.id !== DM_GROUP_ID && (
+                <Menu.Item
+                    id={`mute-${group.id}`}
+                    onClick={toggleMute}
+                    leadingElement={<BellOutlineIcon size={18}/>}
+                    labels={isMuted ? (
+                        <FormattedMessage
+                            id='sidebar_left.sidebar_category_menu.unmuteCategory'
+                            defaultMessage='Unmute Category'
+                        />
+                    ) : (
+                        <FormattedMessage
+                            id='sidebar_left.sidebar_category_menu.muteCategory'
+                            defaultMessage='Mute Category'
+                        />
+                    )}
+                />
+            )}
+            <Menu.Item
+                id={`rename-${group.id}`}
+                onClick={onRename}
+                leadingElement={<PencilOutlineIcon size={18}/>}
+                labels={
+                    <FormattedMessage
+                        id='sidebar_left.sidebar_category_menu.renameCategory'
+                        defaultMessage='Rename Category'
+                    />
+                }
+            />
+            {!isBuiltInGroup(group.id) && (
+                <Menu.Item
+                    id={`delete-${group.id}`}
+                    isDestructive={true}
+                    onClick={() => setAllTeamsLayout(deleteGroup(getAllTeamsLayout(), group.id))}
+                    leadingElement={<TrashCanOutlineIcon size={18}/>}
+                    labels={
+                        <FormattedMessage
+                            id='sidebar_left.sidebar_category_menu.deleteCategory'
+                            defaultMessage='Delete Category'
+                        />
+                    }
+                />
+            )}
+            <Menu.Separator/>
+            <Menu.SubMenu
+                id={`sortChannels-${group.id}`}
+                leadingElement={sortIcons[group.sorting]}
+                labels={
+                    <FormattedMessage
+                        id='sidebar.sort'
+                        defaultMessage='Sort'
+                    />
+                }
+                trailingElements={(
+                    <>
+                        {sortLabels[group.sorting]}
+                        <ChevronRightIcon size={16}/>
+                    </>
+                )}
+                menuId={`sortChannels-${group.id}-menu`}
+            >
+                {sortItem('alpha', alphaLabel)}
+                {sortItem('recency', recencyLabel)}
+                {sortItem('manual', manualLabel)}
+                <Menu.Separator/>
+                <Menu.Item
+                    id={`unreadFirst-${group.id}`}
+                    labels={<span>{'Unread on top'}</span>}
+                    onClick={() => setAllTeamsLayout(setGroupOptions(getAllTeamsLayout(), group.id, {unreadFirst: !unreadFirst, groupByTeam: group.groupByTeam}))}
+                    trailingElements={unreadFirst ? <CheckIcon size={16}/> : null}
+                />
+                <Menu.Item
+                    id={`groupByTeam-${group.id}`}
+                    labels={<span>{'Group by team'}</span>}
+                    onClick={() => setAllTeamsLayout(setGroupOptions(getAllTeamsLayout(), group.id, {unreadFirst: group.unreadFirst, groupByTeam: !group.groupByTeam}))}
+                    trailingElements={group.groupByTeam ? <CheckIcon size={16}/> : null}
+                />
+            </Menu.SubMenu>
+            <Menu.Separator/>
+            <Menu.Item
+                id={`create-${group.id}`}
+                onClick={() => requestNewGroup()}
+                leadingElement={<FolderPlusOutlineIcon size={18}/>}
+                labels={
+                    <FormattedMessage
+                        id='sidebar_left.sidebar_category_menu.createCategory'
+                        defaultMessage='Create New Category'
+                    />
+                }
+            />
+        </SidebarCategoryGenericMenu>
+    );
+}
