+// PATCH(all-teams): treat transient 5xx/network failures during initial bootstrap as not loaded
+// so Root can retry instead of mounting LoggedIn with an empty user/config and forcing logout.
+function isTransientBootstrapError(result: unknown): boolean {
+    const error = (result as {error?: {status_code?: number}} | undefined)?.error;
+    if (!error) {
+        return false;
+    }
+    const status = error.status_code;
+    return status === undefined || status === 0 || status >= 500;
+}
