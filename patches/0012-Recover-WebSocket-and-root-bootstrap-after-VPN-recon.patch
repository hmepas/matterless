+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {ResilientWebSocketClient} from './web_websocket_client';
+
+class FakeWebSocket {
+    static readonly CONNECTING = 0;
+    static readonly OPEN = 1;
+    static readonly CLOSING = 2;
+    static readonly CLOSED = 3;
+
+    static instances: FakeWebSocket[] = [];
+
+    url: string;
+    readyState = FakeWebSocket.CONNECTING;
+    sent: string[] = [];
+    onopen: (() => void) | null = null;
+    onclose: (() => void) | null = null;
+    onerror: ((err: Event) => void) | null = null;
+    onmessage: ((evt: {data: string}) => void) | null = null;
+
+    constructor(url: string) {
+        this.url = url;
+        FakeWebSocket.instances.push(this);
+    }
+
+    send(data: string) {
+        this.sent.push(data);
+    }
+
+    close() {
+        this.readyState = FakeWebSocket.CLOSED;
+        this.onclose?.();
+    }
+
+    triggerOpen() {
+        this.readyState = FakeWebSocket.OPEN;
+        this.onopen?.();
+    }
+
+    triggerClose() {
+        this.readyState = FakeWebSocket.CLOSED;
+        this.onclose?.();
+    }
+
+    triggerMessage(payload: unknown) {
+        this.onmessage?.({data: JSON.stringify(payload)});
+    }
+}
+
+describe('ResilientWebSocketClient', () => {
+    const originalWebSocket = global.WebSocket;
+    let clients: ResilientWebSocketClient[] = [];
+
+    const createClient = () => {
+        const client = new ResilientWebSocketClient();
+        clients.push(client);
+        return client;
+    };
+
+    beforeEach(() => {
+        jest.useFakeTimers();
+        FakeWebSocket.instances = [];
+        clients = [];
+        (global as unknown as {WebSocket: typeof FakeWebSocket}).WebSocket = FakeWebSocket;
+    });
+
+    afterEach(() => {
+        for (const client of clients) {
+            client.close();
+        }
+        clients = [];
+        jest.useRealTimers();
+        (global as unknown as {WebSocket: typeof WebSocket}).WebSocket = originalWebSocket;
+    });
+
+    test('caps reconnect backoff at 15s after repeated failures', () => {
+        const client = createClient();
+        client.initialize('ws://localhost:9005/api/v4/websocket');
+
+        // Fail 10 consecutive attempts (exceeding maxWebSocketFails = 7).
+        for (let i = 0; i < 10; i++) {
+            const ws = FakeWebSocket.instances[FakeWebSocket.instances.length - 1];
+            ws.triggerClose();
+            jest.advanceTimersByTime(17001);
+        }
+
+        // After 10 failures, next retry must still occur within 15s + 2s jitter (not 5 minutes).
+        const countBefore = FakeWebSocket.instances.length;
+        const latest = FakeWebSocket.instances[countBefore - 1];
+        latest.triggerClose();
+
+        jest.advanceTimersByTime(17001);
+        expect(FakeWebSocket.instances.length).toBe(countBefore + 1);
+    });
+
+    test('reconnects promptly on window focus and still fires reconnect listeners', () => {
+        const client = createClient();
+        const reconnectListener = jest.fn();
+        const firstConnectListener = jest.fn();
+        client.addReconnectListener(reconnectListener);
+        client.addFirstConnectListener(firstConnectListener);
+
+        client.initialize('ws://localhost:9005/api/v4/websocket');
+        FakeWebSocket.instances[0].triggerOpen();
+        expect(firstConnectListener).toHaveBeenCalledTimes(1);
+
+        // Simulate VPN drop with repeated failures pushing into backoff.
+        for (let i = 0; i < 8; i++) {
+            FakeWebSocket.instances[FakeWebSocket.instances.length - 1].triggerClose();
+            if (i < 7) {
+                jest.advanceTimersByTime(5100);
+            }
+        }
+
+        const countBeforeFocus = FakeWebSocket.instances.length;
+
+        // Focusing the window cancels the backoff timer and retries immediately after debounce.
+        window.dispatchEvent(new Event('focus'));
+        jest.advanceTimersByTime(300);
+
+        expect(FakeWebSocket.instances.length).toBe(countBeforeFocus + 1);
+
+        // Once the new socket opens, reconnectListeners (not firstConnectListeners) must run.
+        FakeWebSocket.instances[FakeWebSocket.instances.length - 1].triggerOpen();
+        expect(reconnectListener).toHaveBeenCalledTimes(1);
+        expect(firstConnectListener).toHaveBeenCalledTimes(1);
+    });
+
+    test('closes a half-open socket if ping gets no reply on resume', () => {
+        const client = createClient();
+        client.initialize('ws://localhost:9005/api/v4/websocket');
+        const ws = FakeWebSocket.instances[0];
+        ws.triggerOpen();
+
+        // Simulate returning to the window while the socket is half-open (no pong arrives).
+        window.dispatchEvent(new Event('online'));
+        jest.advanceTimersByTime(300);
+
+        expect(ws.sent.some((msg) => msg.includes('"action":"ping"'))).toBe(true);
+
+        // After the 5s health probe timeout, the zombie socket is closed so reconnect can start.
+        jest.advanceTimersByTime(5000);
+        expect(ws.readyState).toBe(FakeWebSocket.CLOSED);
+
+        // And a fresh socket is opened after the initial 3s retry wait (+ up to 2s jitter).
+        jest.advanceTimersByTime(5100);
+        expect(FakeWebSocket.instances.length).toBe(2);
+    });
+
+    test('keeps a healthy socket open when ping receives a reply on resume', () => {
+        const client = createClient();
+        client.initialize('ws://localhost:9005/api/v4/websocket');
+        const ws = FakeWebSocket.instances[0];
+        ws.triggerOpen();
+
+        window.dispatchEvent(new Event('focus'));
+        jest.advanceTimersByTime(300);
+
+        const pingMsg = JSON.parse(ws.sent[ws.sent.length - 1]);
+        expect(pingMsg.action).toBe('ping');
+
+        // Server answers pong before the 5s timeout.
+        ws.triggerMessage({seq_reply: pingMsg.seq, status: 'OK'});
+
+        jest.advanceTimersByTime(6000);
+        expect(ws.readyState).toBe(FakeWebSocket.OPEN);
+        expect(FakeWebSocket.instances.length).toBe(1);
+    });
+
+    test('does not reconnect on focus after explicit close', () => {
+        const client = createClient();
+        client.initialize('ws://localhost:9005/api/v4/websocket');
+        client.close();
+
+        const countAfterClose = FakeWebSocket.instances.length;
+        window.dispatchEvent(new Event('focus'));
+        window.dispatchEvent(new Event('online'));
+        jest.advanceTimersByTime(1000);
+
+        expect(FakeWebSocket.instances.length).toBe(countAfterClose);
+    });
+});
