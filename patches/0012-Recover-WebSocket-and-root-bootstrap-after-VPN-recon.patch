 // Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
 // See LICENSE.txt for license information.
 
+// PATCH(all-teams): cap WebSocket reconnect backoff at 15s (instead of upstream's 5 minutes) and
+// recover promptly when the window regains focus, visibility, or network connectivity after a
+// VPN drop or sleep. Also probe an apparently open socket on resume so half-open connections are
+// closed within 5s instead of waiting for the full 30-60s ping interval.
+
 import {WebSocketClient} from '@mattermost/client';
 
-const WebClient = new WebSocketClient();
+const MAX_RETRY_TIME_MS = 15000;
+const RESUME_DEBOUNCE_MS = 250;
+const HEALTH_PROBE_TIMEOUT_MS = 5000;
+
+type WebSocketClientInternals = {
+    conn: WebSocket | null;
+    connectFailCount: number;
+};
+
+export class ResilientWebSocketClient extends WebSocketClient {
+    private active = false;
+    private lastConnectionUrl?: string;
+    private lastToken?: string;
+    private lastPostedAck?: boolean;
+    private listenersAttached = false;
+    private resumeTimer: ReturnType<typeof setTimeout> | null = null;
+    private probeTimer: ReturnType<typeof setTimeout> | null = null;
+
+    constructor() {
+        super({
+            maxWebSocketRetryTime: MAX_RETRY_TIME_MS,
+        });
+    }
+
+    private internals(): WebSocketClientInternals {
+        return this as unknown as WebSocketClientInternals;
+    }
+
+    public initialize(connectionUrl: string, token?: string, postedAck?: boolean): void {
+        if (connectionUrl) {
+            this.lastConnectionUrl = connectionUrl;
+        }
+        if (token !== undefined) {
+            this.lastToken = token;
+        }
+        if (postedAck !== undefined) {
+            this.lastPostedAck = postedAck;
+        }
+        this.active = true;
+        this.attachResumeListeners();
+        super.initialize(connectionUrl, token, postedAck);
+    }
+
+    public close(): void {
+        this.active = false;
+        this.detachResumeListeners();
+        this.clearTimers();
+        super.close();
+    }
+
+    private attachResumeListeners(): void {
+        if (this.listenersAttached || typeof window === 'undefined') {
+            return;
+        }
+        this.listenersAttached = true;
+        window.addEventListener('online', this.handleResume);
+        window.addEventListener('focus', this.handleResume);
+        if (typeof document !== 'undefined') {
+            document.addEventListener('visibilitychange', this.handleVisibilityChange);
+        }
+    }
+
+    private detachResumeListeners(): void {
+        if (!this.listenersAttached || typeof window === 'undefined') {
+            return;
+        }
+        this.listenersAttached = false;
+        window.removeEventListener('online', this.handleResume);
+        window.removeEventListener('focus', this.handleResume);
+        if (typeof document !== 'undefined') {
+            document.removeEventListener('visibilitychange', this.handleVisibilityChange);
+        }
+    }
+
+    private clearTimers(): void {
+        if (this.resumeTimer) {
+            clearTimeout(this.resumeTimer);
+            this.resumeTimer = null;
+        }
+        if (this.probeTimer) {
+            clearTimeout(this.probeTimer);
+            this.probeTimer = null;
+        }
+    }
+
+    private handleVisibilityChange = (): void => {
+        if (typeof document !== 'undefined' && document.visibilityState === 'visible') {
+            this.handleResume();
+        }
+    };
+
+    private handleResume = (): void => {
+        if (!this.active || !this.lastConnectionUrl) {
+            return;
+        }
+        if (this.resumeTimer) {
+            clearTimeout(this.resumeTimer);
+        }
+        this.resumeTimer = setTimeout(() => {
+            this.resumeTimer = null;
+            this.checkOrReconnect();
+        }, RESUME_DEBOUNCE_MS);
+    };
+
+    private checkOrReconnect(): void {
+        if (!this.active || !this.lastConnectionUrl) {
+            return;
+        }
+        const internals = this.internals();
+        const conn = internals.conn;
+        const openState = typeof WebSocket === 'undefined' ? 1 : WebSocket.OPEN;
+        const closedState = typeof WebSocket === 'undefined' ? 3 : WebSocket.CLOSED;
+
+        if (!conn || conn.readyState === closedState) {
+            this.clearReconnectTimeout();
+
+            // Keep connectFailCount at >= 1 when recovering from prior failures so WebSocketClient's
+            // onopen still fires reconnectListeners (syncing missed posts/unreads), while resetting
+            // any deep exponential backoff back to the initial 3s retry interval.
+            if (internals.connectFailCount > 1) {
+                internals.connectFailCount = 1;
+            }
+            super.initialize(this.lastConnectionUrl, this.lastToken, this.lastPostedAck);
+            return;
+        }
+
+        if (conn.readyState === openState && !this.probeTimer) {
+            const probedConn = conn;
+            this.probeTimer = setTimeout(() => {
+                this.probeTimer = null;
+                if (this.internals().conn === probedConn && probedConn.readyState === openState) {
+                    const prevOnClose = probedConn.onclose;
+                    probedConn.onclose = null;
+                    probedConn.close();
+                    prevOnClose?.call(probedConn, {code: 1006, wasClean: false} as CloseEvent);
+                }
+            }, HEALTH_PROBE_TIMEOUT_MS);
+            this.ping(() => {
+                if (this.probeTimer) {
+                    clearTimeout(this.probeTimer);
+                    this.probeTimer = null;
+                }
+            });
+        }
+    }
+}
+
+const WebClient = new ResilientWebSocketClient();
 export default WebClient;
