         instance.onDragEnd(channelResult);
         expect(baseProps.actions.moveChannelsInSidebar).toHaveBeenCalledWith(channelResult.destination!.droppableId, channelResult.destination!.index, channelResult.draggableId);
     });
+
+    describe('ALL mode', () => {
+        // The list is 100..500 on screen and scrolled to 1000; `item` says where the channel is right now.
+        const renderInAllMode = (item: {top: number; bottom: number}) => {
+            setAllTeamsMode(true);
+            const wrapper = shallowWithIntl(
+                <SidebarList
+                    {...baseProps}
+                    currentChannelId=''
+                />,
+            );
+            const instance = wrapper.instance() as SidebarListComponent;
+            const scrollTop = jest.fn();
+            instance.scrollbar = {
+                current: {
+                    container: {getBoundingClientRect: () => ({top: 100, bottom: 500})},
+                    getScrollTop: () => 1000,
+                    scrollTop,
+                    scrollToTop: jest.fn(),
+                } as any,
+            };
+            instance.channelRefs.set('picked', {getBoundingClientRect: () => item} as any);
+
+            const select = (extra = {}) => wrapper.setProps({currentChannelId: 'picked', ...extra});
+            return {scrollTop, scrollToTop: instance.scrollbar.current!.scrollToTop as jest.Mock, select};
+        };
+
+        afterEach(() => setAllTeamsMode(false));
+
+        test('changing team does not scroll the list to the top', () => {
+            const {scrollToTop, select} = renderInAllMode({top: 200, bottom: 232});
+            select();
+            select({currentTeam: {...baseProps.currentTeam, id: 'other_team'}});
+            expect(scrollToTop).not.toHaveBeenCalled();
+        });
+
+        test('a selected channel that is visible does not move the list', () => {
+            const {scrollTop, select} = renderInAllMode({top: 200, bottom: 232});
+            select();
+            expect(scrollTop).not.toHaveBeenCalled();
+        });
+
+        test('a selected channel below the visible part is scrolled to', () => {
+            const {scrollTop, select} = renderInAllMode({top: 600, bottom: 632});
+            select();
+            expect(scrollTop).toHaveBeenCalledTimes(1);
+            expect(scrollTop.mock.calls[0][0]).toBeGreaterThanOrEqual(1132);
+        });
+
+        test('a selected channel above the visible part is scrolled to', () => {
+            const {scrollTop, select} = renderInAllMode({top: -300, bottom: -268});
+            select();
+            expect(scrollTop).toHaveBeenCalledTimes(1);
+            expect(scrollTop.mock.calls[0][0]).toBeLessThanOrEqual(600);
+        });
+
+        test('it scrolls once per selection, so manual scrolling sticks', () => {
+            const {scrollTop, select} = renderInAllMode({top: 600, bottom: 632});
+            select();
+            select({hasUnreadThreads: true});
+            expect(scrollTop).toHaveBeenCalledTimes(1);
+        });
+    });
 });
