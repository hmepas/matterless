+        const hiddenAbove = (box.top + categoryHeaderHeight) - item.top;
+        const hiddenBelow = item.bottom - box.bottom;
+
+        if (hiddenAbove > 0) {
+            scrollbar.scrollTop(scrollbar.getScrollTop() - hiddenAbove - scrollMargin);
+        } else if (hiddenBelow > 0) {
+            scrollbar.scrollTop(scrollbar.getScrollTop() + hiddenBelow + scrollMargin);
+        }
