+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): show a muted check while a post is sending and an explicit error icon if
+// sending failed, so a dropped message cannot go unnoticed.
+
+import React from 'react';
+import {useIntl} from 'react-intl';
+
+import {AlertCircleOutlineIcon, CheckIcon} from '@mattermost/compass-icons/components';
+import type {Post} from '@mattermost/types/posts';
+
+import {isPostEphemeral, isSystemMessage} from 'mattermost-redux/utils/post_utils';
+
+import './post_send_status.scss';
+
+export function isPostPending(post: Post) {
+    return Boolean(post.pending_post_id) && post.id === post.pending_post_id;
+}
+
+export function PostSendStatus({post}: {post: Post}) {
+    const {formatMessage} = useIntl();
+
+    if (isSystemMessage(post) || isPostEphemeral(post)) {
+        return null;
+    }
+
+    if (post.failed) {
+        const label = formatMessage({id: 'post_send.failed', defaultMessage: 'Not sent'});
+        return (
+            <div className='post-send-extra'>
+                <div className='post-send-extra__item'>
+                    <span
+                        aria-label={label}
+                        className='post-send-status post-send-status_failed'
+                        data-testid='postSendFailed'
+                        role='img'
+                        title={label}
+                    >
+                        <AlertCircleOutlineIcon size={16}/>
+                    </span>
+                </div>
+            </div>
+        );
+    }
+
+    if (isPostPending(post)) {
+        return (
+            <div className='post-send-extra'>
+                <div className='post-send-extra__item'>
+                    <span
+                        className='post-send-status'
+                        data-testid='postSendPending'
+                    >
+                        <span className='post-send-status__icon'>
+                            <CheckIcon/>
+                        </span>
+                    </span>
+                </div>
+            </div>
+        );
+    }
+
+    return null;
+}
