+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {renderWithContext, screen} from 'tests/react_testing_utils';
+import {TestHelper} from 'utils/test_helper';
+
+import {PostSendStatus} from './index';
+
+const post = TestHelper.getPostMock({id: 'p1', channel_id: 'c1', user_id: 'me', type: '', pending_post_id: ''});
+const pending = {...post, id: 'me:1', pending_post_id: 'me:1'};
+
+describe('PostSendStatus', () => {
+    test('shows a sending mark while a post is pending', () => {
+        renderWithContext(<PostSendStatus post={pending}/>);
+        expect(screen.getByTestId('postSendPending')).toBeInTheDocument();
+        expect(screen.queryByTestId('postSendFailed')).not.toBeInTheDocument();
+    });
+
+    test('shows a failed mark when sending fails', () => {
+        renderWithContext(<PostSendStatus post={{...pending, failed: true}}/>);
+        expect(screen.getByTestId('postSendFailed')).toBeInTheDocument();
+        expect(screen.queryByTestId('postSendPending')).not.toBeInTheDocument();
+    });
+
+    test('renders nothing once delivered', () => {
+        const {container} = renderWithContext(<PostSendStatus post={post}/>);
+        expect(container.firstChild).toBeNull();
+    });
+
+    test('renders nothing for system posts', () => {
+        const {container} = renderWithContext(<PostSendStatus post={{...pending, type: 'system_join_channel'}}/>);
+        expect(container.firstChild).toBeNull();
+    });
+});
