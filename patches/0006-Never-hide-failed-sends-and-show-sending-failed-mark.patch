+// PATCH(all-teams): styles for pending and failed post send status icons.
+.post .post-send-extra {
+    position: relative;
+    display: flex;
+    width: 30px;
+    flex-direction: column;
+    align-items: center;
+    justify-content: flex-end;
+    padding-bottom: 8px;
+}
+
+.post .post-send-extra__item {
+    display: flex;
+    min-width: 18px;
+    min-height: 16px;
+    align-items: center;
+    justify-content: center;
+}
+
+.post-send-status {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 2px;
+    pointer-events: auto;
+}
+
+.post-send-status_failed {
+    color: var(--error-text, #d24b4e);
+}
+
+.post-send-status__icon {
+    display: inline-flex;
+    color: rgba(var(--center-channel-color-rgb), 0.45);
+    font-size: 16px;
+    line-height: 1;
+}
