+// PATCH(all-teams): the proxy can't know about a send that never reached it. Ids and statuses only.
+function reportFailedPost(post: Post, error: any, isWebsocketConnected: boolean) {
+    fetch('/__client_log', {
+        method: 'POST',
+        headers: {'Content-Type': 'application/json'},
+        body: JSON.stringify({
+            event: 'post_failed',
+            pending_post_id: post.pending_post_id,
+            channel_id: post.channel_id,
+            root_id: post.root_id,
+            status_code: error.status_code,
+            server_error_id: error.server_error_id,
+            online: navigator.onLine,
+            ws: isWebsocketConnected,
+        }),
+    }).catch(() => {
+        // Logging must never get in the way of the send's own failure handling.
+    });
+}
+
 export function createPost(
     post: Post,
     files: any[] = [],
@@ -288,18 +308,11 @@ export function createPost(
                     update_at: Date.now(),
                 };
                 actions = [{type: PostTypes.CREATE_POST_FAILURE, error}];
+                reportFailedPost(data, error, getState().websocket.connected);
 
-                // If the failure was because: the root post was deleted or
-                // TownSquareIsReadOnly=true then remove the post
-                if (error.server_error_id === 'api.post.create_post.root_id.app_error' ||
-                    error.server_error_id === 'api.post.create_post.town_square_read_only' ||
-                    error.server_error_id === 'plugin.message_will_be_posted.dismiss_post'
-                ) {
-                    // RemovePost is a Thunk, and not handled by batchActions
-                    dispatch(removePost(data));
-                } else {
-                    actions.push(receivedPost(data, crtEnabled));
-                }
+                // PATCH(all-teams): upstream silently removes the post on some errors, which looks like
+                // a message that was sent. It stays as failed instead: Cancel removes it.
+                actions.push(receivedPost(data, crtEnabled));
 
                 dispatch(batchActions(actions, 'BATCH_CREATE_POST_FAILED'));
                 return {error};
