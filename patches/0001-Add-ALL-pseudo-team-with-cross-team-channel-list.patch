+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+type Mode = typeof import('./all_teams_mode');
+
+const KEY = 'mm_all_teams_layout';
+
+const response = (status: number, body = '') => ({status, ok: status < 300, text: async () => body});
+const flush = () => new Promise((resolve) => setTimeout(resolve));
+
+function load(): Mode {
+    let mode: Mode;
+    jest.isolateModules(() => {
+        mode = require('./all_teams_mode');
+    });
+    return mode!;
+}
+
+const mine = (mode: Mode) => mode.addGroup(mode.makeDefaultLayout(), 'g', 'Mine');
+const names = (mode: Mode) => mode.getAllTeamsLayout().groups.map((group) => group.name);
+const puts = (fetchMock: jest.Mock) => fetchMock.mock.calls.filter(([, init]) => init?.method === 'PUT');
+
+describe('ALL layout persistence', () => {
+    let fetchMock: jest.Mock;
+
+    beforeEach(() => {
+        window.localStorage.clear();
+        fetchMock = jest.fn().mockResolvedValue(response(204));
+        global.fetch = fetchMock;
+    });
+
+    test('the file restores a wiped localStorage', async () => {
+        const mode = load();
+        fetchMock.mockResolvedValue(response(200, JSON.stringify(mine(mode))));
+
+        await mode.syncAllTeamsLayout();
+
+        expect(names(mode)).toEqual(['Mine', 'Channels', 'Direct messages']);
+        expect(JSON.parse(window.localStorage.getItem(KEY)!).groups).toHaveLength(3);
+        expect(puts(fetchMock)).toHaveLength(0);
+    });
+
+    test('with no file yet, an existing localStorage layout seeds it', async () => {
+        window.localStorage.setItem(KEY, JSON.stringify(mine(load())));
+        const mode = load();
+
+        await mode.syncAllTeamsLayout();
+        await flush();
+
+        expect(names(mode)).toEqual(['Mine', 'Channels', 'Direct messages']);
+        expect(JSON.parse(puts(fetchMock)[0][1].body).groups).toHaveLength(3);
+    });
+
+    test('changes reach the file in order', async () => {
+        const mode = load();
+        await mode.syncAllTeamsLayout();
+        await flush();
+        fetchMock.mockClear();
+
+        mode.setAllTeamsLayout(mine(mode));
+        mode.setAllTeamsLayout(mode.renameGroup(mine(mode), 'g', 'Renamed'));
+        await flush();
+
+        expect(puts(fetchMock).map(([, init]) => JSON.parse(init.body).groups[0].name)).toEqual(['Mine', 'Renamed']);
+    });
+
+    test.each([
+        ['corrupt file', () => Promise.resolve(response(200, '{oops'))],
+        ['server error', () => Promise.resolve(response(500))],
+        ['network failure', () => Promise.reject(new Error('down'))],
+    ])('%s: keeps localStorage and never overwrites the file', async (_, reply) => {
+        window.localStorage.setItem(KEY, JSON.stringify(mine(load())));
+        const mode = load();
+        fetchMock.mockImplementation(reply);
+
+        await mode.syncAllTeamsLayout();
+        mode.setAllTeamsLayout(mode.renameGroup(mode.getAllTeamsLayout(), 'g', 'Local'));
+        await flush();
+
+        expect(names(mode)).toEqual(['Local', 'Channels', 'Direct messages']);
+        expect(puts(fetchMock)).toHaveLength(0);
+    });
+});
diff --git a/webapp/channels/src/utils/all_teams_mode.ts b/webapp/channels/src/utils/all_teams_mode.ts
