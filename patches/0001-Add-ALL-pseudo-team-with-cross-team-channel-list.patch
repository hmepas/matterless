+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): the cross-team channel list shown instead of categories in "ALL" mode.
+
+import {DragDropContext, Draggable, Droppable} from '@hello-pangea/dnd';
+import type {BeforeCapture, DropResult} from '@hello-pangea/dnd';
+import classNames from 'classnames';
+import React, {useCallback, useEffect, useMemo, useState} from 'react';
+import {useSelector} from 'react-redux';
+
+import {General} from 'mattermost-redux/constants';
+import {getAllChannels} from 'mattermost-redux/selectors/entities/channels';
+
+import {makeGetAllTeamsGroups} from 'selectors/views/all_teams';
+import type {AllTeamsShownGroup} from 'selectors/views/all_teams';
+
+import {SidebarCategoryHeader} from 'components/sidebar/sidebar_category_header';
+import SidebarChannel from 'components/sidebar/sidebar_channel';
+
+import {
+    addGroup,
+    DEFAULT_GROUP_ID,
+    deleteGroup,
+    DM_GROUP_ID,
+    getAllTeamsLayout,
+    isBuiltInGroup,
+    moveChannel,
+    moveGroup,
+    renameGroup,
+    setAllTeamsLayout,
+    setGroupCollapsed,
+    setGroupSorting,
+    syncAllTeamsLayout,
+    useAllTeamsLayout,
+} from 'utils/all_teams_mode';
+import type {AllTeamsSorting} from 'utils/all_teams_mode';
+import {generateId} from 'utils/utils';
+
+import type {GlobalState} from 'types/store';
+
+import './all_teams_list.scss';
+
+const GROUPS_DROPPABLE_ID = 'all-teams-groups';
+
+const NEXT_SORTING: Record<AllTeamsSorting, AllTeamsSorting> = {manual: 'recency', recency: 'alpha', alpha: 'manual'};
+
+const SORTING_ICONS: Record<AllTeamsSorting, string> = {
+    manual: 'icon-drag-vertical',
+    recency: 'icon-clock-outline',
+    alpha: 'icon-sort-alphabetical-ascending',
+};
+
+const SORTING_TITLES: Record<AllTeamsSorting, string> = {
+    manual: 'Manual order. Click to sort by recent activity',
+    recency: 'Sorted by recent activity. Click to sort A-Z',
+    alpha: 'Sorted A-Z. Click to switch to manual order',
+};
+
+type NameInputProps = {
+    initialValue: string;
+    onDone: (name: string) => void;
+};
+
+function NameInput({initialValue, onDone}: NameInputProps) {
+    const [value, setValue] = useState(initialValue);
+
+    return (
+        <input
+            className='AllTeamsList__nameInput'
+            autoFocus={true}
+            placeholder='Category name'
+            value={value}
+            onChange={(e) => setValue(e.target.value)}
+            onBlur={() => onDone(value.trim())}
+            onKeyDown={(e) => {
+                // Keeps the sidebar's arrow-key navigation out of the text field.
+                e.stopPropagation();
+                if (e.key === 'Enter') {
+                    onDone(value.trim());
+                } else if (e.key === 'Escape') {
+                    onDone('');
+                }
+            }}
+        />
+    );
+}
+
+type Props = {
+    setChannelRef: (channelId: string, ref: HTMLLIElement) => void;
+};
+
+export default function AllTeamsList({setChannelRef}: Props) {
+    const layout = useAllTeamsLayout();
+    const getGroups = useMemo(() => makeGetAllTeamsGroups(), []);
+    const groups = useSelector((state: GlobalState) => getGroups(state, layout));
+    const allChannels = useSelector(getAllChannels);
+
+    useEffect(() => {
+        syncAllTeamsLayout();
+    }, []);
+
+    const [isCreating, setIsCreating] = useState(false);
+    const [editingId, setEditingId] = useState('');
+    const [draggedGroupId, setDraggedGroupId] = useState('');
+    const [draggedKind, setDraggedKind] = useState<'dm' | 'channel' | ''>('');
+
+    const onBeforeCapture = (before: BeforeCapture) => {
+        const dragged = allChannels[before.draggableId];
+        if (dragged) {
+            setDraggedKind(dragged.type === General.DM_CHANNEL || dragged.type === General.GM_CHANNEL ? 'dm' : 'channel');
+        }
+
+        // A group is dragged with its channels hidden, like a native category. The drag library needs
+        // the scroll box to keep its height while it measures that smaller layout.
+        if (getAllTeamsLayout().groups.some((group) => group.id === before.draggableId)) {
+            const list = document.getElementById(GROUPS_DROPPABLE_ID);
+            if (list) {
+                list.style.height = `${list.scrollHeight}px`;
+            }
+            setDraggedGroupId(before.draggableId);
+        }
+    };
+
+    const onDragStart = useCallback(() => {
+        const list = document.getElementById(GROUPS_DROPPABLE_ID);
+        if (list) {
+            list.style.height = '';
+        }
+    }, []);
+
+    const onDragEnd = (result: DropResult) => {
+        setDraggedGroupId('');
+        setDraggedKind('');
+
+        if (result.reason !== 'DROP' || !result.destination) {
+            return;
+        }
+
+        const {droppableId, index} = result.destination;
+        if (result.type === 'SIDEBAR_CATEGORY') {
+            setAllTeamsLayout(moveGroup(layout, result.draggableId, index));
+        } else {
+            const shownIds = groups.find(({group}) => group.id === droppableId)?.shownIds ?? [];
+            setAllTeamsLayout(moveChannel(layout, result.draggableId, droppableId, index, shownIds));
+        }
+    };
+
+    const finishCreating = (name: string) => {
+        setIsCreating(false);
+        if (name) {
+            setAllTeamsLayout(addGroup(layout, generateId(), name));
+        }
+    };
+
+    const finishRenaming = (groupId: string, name: string) => {
+        setEditingId('');
+        if (name) {
+            setAllTeamsLayout(renameGroup(layout, groupId, name));
+        }
+    };
+
+    const renderGroup = ({group, shownIds}: AllTeamsShownGroup, groupIndex: number) => {
+        const isEditing = editingId === group.id;
+        const isDragged = draggedGroupId === group.id;
+
+        return (
+            <Draggable
+                key={group.id}
+                draggableId={group.id}
+                index={groupIndex}
+                isDragDisabled={isEditing}
+                disableInteractiveElementBlocking={true}
+            >
+                {(provided, snapshot) => (
+                    <div
+                        className={classNames('SidebarChannelGroup a11y__section', {isCollapsed: group.collapsed})}
+                        ref={provided.innerRef}
+                        {...provided.draggableProps}
+                    >
+                        <Droppable
+                            droppableId={group.id}
+                            type='SIDEBAR_CHANNEL'
+
+                            // DMs and channels only mix in custom categories, as in native ones.
+                            isDropDisabled={(group.id === DM_GROUP_ID && draggedKind === 'channel') || (group.id === DEFAULT_GROUP_ID && draggedKind === 'dm')}
+                        >
+                            {(droppableProvided, droppableSnapshot) => (
+                                <div
+                                    {...droppableProvided.droppableProps}
+                                    ref={droppableProvided.innerRef}
+                                    className={classNames({draggingOver: droppableSnapshot.isDraggingOver})}
+                                >
+                                    {isEditing ? (
+                                        <NameInput
+                                            initialValue={group.name}
+                                            onDone={(name) => finishRenaming(group.id, name)}
+                                        />
+                                    ) : (
+                                        <SidebarCategoryHeader
+                                            displayName={group.name}
+                                            dragHandleProps={provided.dragHandleProps}
+                                            isCollapsed={group.collapsed}
+                                            isCollapsible={true}
+                                            isDragging={snapshot.isDragging}
+                                            isDraggingOver={droppableSnapshot.isDraggingOver}
+                                            muted={false}
+                                            onClick={() => setAllTeamsLayout(setGroupCollapsed(layout, group.id, !group.collapsed))}
+                                        >
+                                            <button
+                                                className='AllTeamsList__action AllTeamsList__action--onHover'
+                                                title='Rename category'
+                                                aria-label='Rename category'
+                                                onClick={() => setEditingId(group.id)}
+                                            >
+                                                <i className='icon icon-pencil-outline'/>
+                                            </button>
+                                            {!isBuiltInGroup(group.id) && (
+                                                <button
+                                                    className='AllTeamsList__action AllTeamsList__action--onHover'
+                                                    title='Delete category. Its channels go back to Channels and Direct messages'
+                                                    aria-label='Delete category'
+                                                    onClick={() => setAllTeamsLayout(deleteGroup(layout, group.id))}
+                                                >
+                                                    <i className='icon icon-trash-can-outline'/>
+                                                </button>
+                                            )}
+                                            <button
+                                                className='AllTeamsList__action'
+                                                title={SORTING_TITLES[group.sorting]}
+                                                aria-label={SORTING_TITLES[group.sorting]}
+                                                onClick={() => setAllTeamsLayout(setGroupSorting(layout, group.id, NEXT_SORTING[group.sorting]))}
+                                            >
+                                                <i className={`icon ${SORTING_ICONS[group.sorting]}`}/>
+                                            </button>
+                                        </SidebarCategoryHeader>
+                                    )}
+                                    <div className='SidebarChannelGroup_content'>
+                                        <ul className='NavGroupContent'>
+                                            {!isDragged && shownIds.map((channelId, index) => (
+                                                <SidebarChannel
+                                                    key={channelId}
+                                                    channelId={channelId}
+                                                    channelIndex={index}
+                                                    isCategoryCollapsed={false}
+                                                    isCategoryDragged={false}
+                                                    isDraggable={true}
+                                                    isAutoSortedCategory={false}
+                                                    setChannelRef={setChannelRef}
+                                                    alwaysShowTeam={true}
+                                                />
+                                            ))}
+                                            {droppableProvided.placeholder}
+                                        </ul>
+                                    </div>
+                                </div>
+                            )}
+                        </Droppable>
+                    </div>
+                )}
+            </Draggable>
+        );
+    };
+
+    return (
+        <>
+            {isCreating ? (
+                <NameInput
+                    initialValue=''
+                    onDone={finishCreating}
+                />
+            ) : (
+                <button
+                    className='AllTeamsList__newGroup'
+                    onClick={() => setIsCreating(true)}
+                >
+                    <i className='icon icon-plus'/>
+                    {'New category'}
+                </button>
+            )}
+            <DragDropContext
+                onBeforeCapture={onBeforeCapture}
+                onDragStart={onDragStart}
+                onDragEnd={onDragEnd}
+            >
+                <Droppable
+                    droppableId='droppable-all-teams-groups'
+                    type='SIDEBAR_CATEGORY'
+                >
+                    {(provided) => (
+                        <div
+                            id={GROUPS_DROPPABLE_ID}
+                            ref={provided.innerRef}
+                            {...provided.droppableProps}
+                        >
+                            {groups.map(renderGroup)}
+                            {provided.placeholder}
+                        </div>
+                    )}
+                </Droppable>
+            </DragDropContext>
+        </>
+    );
+}
