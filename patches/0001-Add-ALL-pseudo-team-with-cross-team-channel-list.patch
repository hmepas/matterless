+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {renderWithContext, screen, userEvent} from 'tests/react_testing_utils';
+import {getAllTeamsLayout, makeDefaultLayout, setAllTeamsLayout} from 'utils/all_teams_mode';
+
+import AllTeamsList from './all_teams_list';
+
+jest.mock('components/sidebar/sidebar_channel', () => ({
+    __esModule: true,
+    default: ({channelId}: {channelId: string}) => <li>{channelId}</li>,
+}));
+
+const channel = {id: 'c1', display_name: 'One', team_id: 't1', type: 'O', delete_at: 0, last_post_at: 1, create_at: 1};
+const state = {
+    entities: {
+        channels: {
+            channels: {c1: channel},
+            myMembers: {c1: {notify_props: {}, mention_count: 0, msg_count: 1}},
+            messageCounts: {c1: {total: 1}},
+            currentChannelId: '',
+        },
+    },
+};
+
+describe('AllTeamsList', () => {
+    beforeEach(() => {
+        window.localStorage.clear();
+        setAllTeamsLayout(makeDefaultLayout());
+    });
+
+    const render = () => renderWithContext(<AllTeamsList setChannelRef={jest.fn()}/>, state as never);
+
+    test('creates, persists and deletes a category', async () => {
+        render();
+        await userEvent.click(screen.getByText('New category'));
+        await userEvent.type(screen.getByPlaceholderText('Category name'), 'Mine{Enter}');
+
+        expect(screen.getByText('Mine')).toBeInTheDocument();
+        expect(JSON.parse(window.localStorage.getItem('mm_all_teams_layout')!).groups.map((g: {name: string}) => g.name)).toEqual(['Mine', 'Channels', 'Direct messages']);
+
+        await userEvent.click(screen.getAllByLabelText('Delete category')[0]);
+        expect(screen.queryByText('Mine')).not.toBeInTheDocument();
+    });
+
+    test('escape cancels creating a category', async () => {
+        render();
+        await userEvent.click(screen.getByText('New category'));
+        await userEvent.type(screen.getByPlaceholderText('Category name'), 'Mine{Escape}');
+        expect(getAllTeamsLayout().groups).toHaveLength(2);
+    });
+
+    test('collapse hides read channels, expand brings them back', async () => {
+        render();
+        expect(screen.getByText('c1')).toBeInTheDocument();
+        await userEvent.click(screen.getByRole('button', {name: 'Channels'}));
+        expect(screen.queryByText('c1')).not.toBeInTheDocument();
+        await userEvent.click(screen.getByRole('button', {name: 'Channels'}));
+        expect(screen.getByText('c1')).toBeInTheDocument();
+    });
+
+    test('renames a category and cycles its sorting', async () => {
+        render();
+        await userEvent.click(screen.getAllByLabelText('Rename category')[0]);
+        const input = screen.getByPlaceholderText('Category name');
+        await userEvent.clear(input);
+        await userEvent.type(input, 'Rest{Enter}');
+        expect(screen.getByText('Rest')).toBeInTheDocument();
+
+        await userEvent.click(screen.getAllByLabelText(/Sorted by recent activity/)[0]);
+        expect(getAllTeamsLayout().groups[0].sorting).toBe('alpha');
+    });
+});
