index 00000000..618e0b15
--- /dev/null
+++ b/webapp/channels/src/utils/all_teams_mode.ts
@@ -0,0 +1,233 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): UI-only "ALL" pseudo-team. When on, the channel sidebar shows every channel from
+// every team instead of the current team's categories. Its categories and channel order never reach
+// the Mattermost server: the local dev server keeps them in a file, and localStorage is a cache of it.
+
+import {useSyncExternalStore} from 'react';
+
+export type AllTeamsSorting = 'manual' | 'recency' | 'alpha';
+
+export type AllTeamsGroup = {
+    id: string;
+    name: string;
+    collapsed: boolean;
+    sorting: AllTeamsSorting;
+    channelIds: string[];
+};
+
+export type AllTeamsLayout = {
+    groups: AllTeamsGroup[];
+};
+
+// Holds every channel that no other group claims, so it always exists and can't be deleted.
+export const DEFAULT_GROUP_ID = 'default';
+
+// Same idea for DMs and GMs: those that no custom group claims live here.
+export const DM_GROUP_ID = 'dms';
+
+const MODE_KEY = 'mm_all_teams_mode';
+const LAYOUT_KEY = 'mm_all_teams_layout';
+const LAYOUT_URL = '/__all_teams_layout';
+
+export function makeDefaultLayout(): AllTeamsLayout {
+    return {groups: [makeBuiltInGroup(DEFAULT_GROUP_ID, 'Channels'), makeDmGroup()]};
+}
+
+function makeBuiltInGroup(id: string, name: string): AllTeamsGroup {
+    return {id, name, collapsed: false, sorting: 'recency', channelIds: []};
+}
+
+function makeDmGroup() {
+    return makeBuiltInGroup(DM_GROUP_ID, 'Direct messages');
+}
+
+export function isBuiltInGroup(groupId: string) {
+    return groupId === DEFAULT_GROUP_ID || groupId === DM_GROUP_ID;
+}
+
+function readLayout(raw: string | null): AllTeamsLayout | null {
+    try {
+        const layout = JSON.parse(raw ?? '');
+        if (layout.groups.some((group: AllTeamsGroup) => group.id === DEFAULT_GROUP_ID)) {
+            // Layouts saved before DMs were listed don't have this group yet.
+            const hasDms = layout.groups.some((group: AllTeamsGroup) => group.id === DM_GROUP_ID);
+            return hasDms ? layout : {groups: [...layout.groups, makeDmGroup()]};
+        }
+    } catch {
+        // Missing or corrupt.
+    }
+    return null;
+}
+
+export function parseLayout(raw: string | null): AllTeamsLayout {
+    return readLayout(raw) ?? makeDefaultLayout();
+}
+
+function updateGroup(layout: AllTeamsLayout, groupId: string, change: Partial<AllTeamsGroup>): AllTeamsLayout {
+    return {groups: layout.groups.map((group) => (group.id === groupId ? {...group, ...change} : group))};
+}
+
+export function addGroup(layout: AllTeamsLayout, id: string, name: string): AllTeamsLayout {
+    const group: AllTeamsGroup = {id, name, collapsed: false, sorting: 'manual', channelIds: []};
+    return {groups: [group, ...layout.groups]};
+}
+
+export function renameGroup(layout: AllTeamsLayout, groupId: string, name: string): AllTeamsLayout {
+    return updateGroup(layout, groupId, {name});
+}
+
+export function setGroupCollapsed(layout: AllTeamsLayout, groupId: string, collapsed: boolean): AllTeamsLayout {
+    return updateGroup(layout, groupId, {collapsed});
+}
+
+export function setGroupSorting(layout: AllTeamsLayout, groupId: string, sorting: AllTeamsSorting): AllTeamsLayout {
+    return updateGroup(layout, groupId, {sorting});
+}
+
+// Its channels fall back to the built-in groups, because nothing else claims them any more.
+export function deleteGroup(layout: AllTeamsLayout, groupId: string): AllTeamsLayout {
+    if (isBuiltInGroup(groupId)) {
+        return layout;
+    }
+    return {groups: layout.groups.filter((group) => group.id !== groupId)};
+}
+
+export function moveGroup(layout: AllTeamsLayout, groupId: string, index: number): AllTeamsLayout {
+    const moved = layout.groups.find((group) => group.id === groupId);
+    if (!moved) {
+        return layout;
+    }
+    const groups = layout.groups.filter((group) => group !== moved);
+    groups.splice(index, 0, moved);
+    return {groups};
+}
+
+// Drops a channel at `index` of what the destination group currently shows, then pins that order by
+// making the group manual. Channels the group holds but doesn't show (collapsed, archived, not loaded
+// yet) keep their membership at the end of the list.
+export function moveChannel(layout: AllTeamsLayout, channelId: string, destinationId: string, index: number, shownIds: string[]): AllTeamsLayout {
+    return {
+        groups: layout.groups.map((group) => {
+            const others = group.channelIds.filter((id) => id !== channelId);
+            if (group.id !== destinationId) {
+                return others.length === group.channelIds.length ? group : {...group, channelIds: others};
+            }
+
+            const shown = shownIds.filter((id) => id !== channelId);
+            shown.splice(index, 0, channelId);
+            const hidden = others.filter((id) => !shown.includes(id));
+            return {...group, sorting: 'manual' as const, channelIds: [...shown, ...hidden]};
+        }),
+    };
+}
+
+function readStorage(key: string): string | null {
+    try {
+        return window.localStorage.getItem(key);
+    } catch {
+        return null;
+    }
+}
+
+function writeStorage(key: string, value: string) {
+    try {
+        window.localStorage.setItem(key, value);
+    } catch {
+        // Storage can be blocked; the in-memory value still works for this session.
+    }
+}
+
+const listeners = new Set<() => void>();
+let mode = readStorage(MODE_KEY) === '1';
+let layoutState = parseLayout(readStorage(LAYOUT_KEY));
+let syncStarted = false;
+let canPush = false;
+let pushQueue: Promise<unknown> = Promise.resolve();
+
+function emit() {
+    listeners.forEach((listener) => listener());
+}
+
+export function subscribeAllTeams(listener: () => void) {
+    listeners.add(listener);
+    return () => {
+        listeners.delete(listener);
+    };
+}
+
+export function isAllTeamsMode() {
+    return mode;
+}
+
+export function setAllTeamsMode(on: boolean) {
+    if (mode === on) {
+        return;
+    }
+    mode = on;
+    writeStorage(MODE_KEY, on ? '1' : '0');
+    emit();
+}
+
+export function getAllTeamsLayout() {
+    return layoutState;
+}
+
+// Queued so that quick successive changes can't reach the file out of order.
+function pushLayout() {
+    if (!canPush) {
+        return;
+    }
+    const body = JSON.stringify(layoutState);
+    pushQueue = pushQueue.
+        then(() => fetch(LAYOUT_URL, {method: 'PUT', headers: {'Content-Type': 'application/json'}, body})).
+        then((response) => {
+            if (!response.ok) {
+                throw new Error(`HTTP ${response.status}`);
+            }
+        }).
+        catch((error) => {
+            // eslint-disable-next-line no-console
+            console.error('[all-teams] failed to save the layout', error);
+        });
+}
+
+export function setAllTeamsLayout(next: AllTeamsLayout) {
+    layoutState = next;
+    writeStorage(LAYOUT_KEY, JSON.stringify(next));
+    pushLayout();
+    emit();
+}
+
+// The file wins over localStorage, which is what restores a wiped browser profile. With no file yet,
+// localStorage seeds it. If the file can't be read or is corrupt, nothing is pushed, so a bad read
+// can never overwrite a good file.
+export async function syncAllTeamsLayout() {
+    if (syncStarted) {
+        return;
+    }
+    syncStarted = true;
+
+    try {
+        const response = await fetch(LAYOUT_URL, {headers: {Accept: 'application/json'}});
+        if (response.status === 204) {
+            canPush = true;
+            pushLayout();
+        } else if (response.ok) {
+            const layout = readLayout(await response.text());
+            if (layout) {
+                canPush = true;
+                layoutState = layout;
+                writeStorage(LAYOUT_KEY, JSON.stringify(layout));
+                emit();
+            }
+        }
+    } catch {
+        // No dev server to talk to: stay on localStorage.
+    }
+}
+
+export function useAllTeamsLayout() {
+    return useSyncExternalStore(subscribeAllTeams, getAllTeamsLayout);
+}
