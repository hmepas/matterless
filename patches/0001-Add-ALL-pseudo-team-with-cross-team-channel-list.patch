+// PATCH(all-teams)
+.AllTeamsList__newGroup {
+    display: flex;
+    width: 100%;
+    height: 28px;
+    align-items: center;
+    padding: 0 16px 0 19px;
+    border: none;
+    background: transparent;
+    color: rgba(var(--sidebar-text-rgb), 0.64);
+    font-size: 12px;
+    gap: 8px;
+
+    &:hover {
+        color: var(--sidebar-text);
+    }
+}
+
+.AllTeamsList__nameInput {
+    width: calc(100% - 32px);
+    height: 28px;
+    padding: 0 8px;
+    border: 1px solid rgba(var(--sidebar-text-rgb), 0.32);
+    border-radius: 4px;
+    margin: 2px 16px;
+    background: transparent;
+    color: var(--sidebar-text);
+    font-size: 12px;
+}
+
+.AllTeamsList__action {
+    width: 24px;
+    min-width: 24px;
+    height: 24px;
+    padding: 0;
+    border: none;
+    border-radius: 4px;
+    margin-right: 2px;
+    background: transparent;
+    color: rgba(var(--sidebar-text-rgb), 0.64);
+    font-size: 14px;
+    line-height: 14px;
+
+    &:hover {
+        background-color: rgba(255, 255, 255, 0.08);
+        color: var(--sidebar-text);
+    }
+
+    &:last-child {
+        margin-right: 16px;
+    }
+
+    &--onHover {
+        display: none;
+    }
+}
+
+.SidebarChannelGroupHeader:hover .AllTeamsList__action--onHover {
+    display: inline-block;
+}
