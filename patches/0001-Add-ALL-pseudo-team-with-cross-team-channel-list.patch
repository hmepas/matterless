new file mode 100644
index 00000000..78162504
--- /dev/null
+++ b/webapp/channels/src/selectors/views/all_teams.test.ts
@@ -0,0 +1,140 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {addGroup, deleteGroup, makeDefaultLayout, moveChannel, moveGroup, parseLayout, setGroupCollapsed, setGroupSorting} from 'utils/all_teams_mode';
+import type {AllTeamsLayout} from 'utils/all_teams_mode';
+import {TestHelper} from 'utils/test_helper';
+
+import type {GlobalState} from 'types/store';
+
+import {makeGetAllTeamsGroups} from './all_teams';
+
+const channel = (id: string, displayName: string, lastPostAt: number, teamId = 't1') => TestHelper.getChannelMock({id, display_name: displayName, last_post_at: lastPostAt, team_id: teamId, type: 'O', delete_at: 0});
+
+const channels = {
+    a: channel('a', 'Alpha', 100),
+    b: channel('b', 'Bravo', 300, 't2'),
+    c: channel('c', 'Charlie', 200, 't3'),
+    notMine: channel('notMine', 'Not mine', 900),
+    dm1: {...channel('dm1', '', 500, ''), type: 'D' as const, name: 'me__zoe'},
+    dm2: {...channel('dm2', '', 400, ''), type: 'D' as const, name: 'me__adam'},
+    closedDm: {...channel('closedDm', '', 900, ''), type: 'D' as const, name: 'me__gone'},
+};
+const member = (msgCount: number) => ({notify_props: {}, mention_count: 0, mention_count_root: 0, msg_count: msgCount, msg_count_root: msgCount});
+
+const state = {
+    entities: {
+        channels: {
+            channels,
+            currentChannelId: 'a',
+            channelsInTeam: {'': new Set(['dm1', 'dm2', 'closedDm'])},
+            messageCounts: {a: {total: 1, root: 1}, b: {total: 1, root: 1}, c: {total: 5, root: 5}, dm1: {total: 9, root: 9}, dm2: {total: 1, root: 1}, closedDm: {total: 1, root: 1}},
+            myMembers: {a: member(1), b: member(1), c: member(1), dm1: member(1), dm2: member(1), closedDm: member(1)},
+        },
+        general: {config: {}},
+        preferences: {myPreferences: {
+            'direct_channel_show--gone': {value: 'false'},
+            'direct_channel_show--zoe': {value: 'true'},
+            'direct_channel_show--adam': {value: 'true'},
+        }},
+        users: {
+            currentUserId: 'me',
+            profiles: {me: {locale: 'en'}, zoe: {id: 'zoe', username: 'zoe'}, adam: {id: 'adam', username: 'adam'}, gone: {id: 'gone', username: 'gone'}},
+            statuses: {},
+            isManualStatus: {},
+        },
+    },
+    views: {},
+} as unknown as GlobalState;
+
+const allShown = (layout: AllTeamsLayout) => makeGetAllTeamsGroups()(state, layout).map(({group, shownIds}) => [group.id, shownIds]);
+const shown = (layout: AllTeamsLayout) => allShown(layout).filter(([id]) => id !== 'dms');
+
+describe('ALL pseudo-team layout', () => {
+    const base = makeDefaultLayout();
+
+    test('lists my channels from every team, without DMs or channels I left', () => {
+        expect(shown(base)).toEqual([['default', ['b', 'c', 'a']]]);
+    });
+
+    test('sorts A-Z', () => {
+        expect(shown(setGroupSorting(base, 'default', 'alpha'))).toEqual([['default', ['a', 'b', 'c']]]);
+    });
+
+    test('a drop pins the shown order and survives a JSON round trip', () => {
+        const moved = moveChannel(base, 'a', 'default', 0, ['b', 'c', 'a']);
+        expect(moved.groups[0].sorting).toBe('manual');
+        expect(shown(parseLayout(JSON.stringify(moved)))).toEqual([['default', ['a', 'b', 'c']]]);
+    });
+
+    test('a channel dropped into a category leaves the default group', () => {
+        const withGroup = addGroup(base, 'g', 'Mine');
+        expect(shown(moveChannel(withGroup, 'c', 'g', 0, []))).toEqual([['g', ['c']], ['default', ['b', 'a']]]);
+    });
+
+    test('moving between categories leaves no duplicate', () => {
+        let layout = addGroup(addGroup(base, 'g1', 'One'), 'g2', 'Two');
+        layout = moveChannel(layout, 'c', 'g1', 0, []);
+        layout = moveChannel(layout, 'c', 'g2', 0, []);
+        expect(shown(layout)).toEqual([['g2', ['c']], ['g1', []], ['default', ['b', 'a']]]);
+    });
+
+    test('a newly joined channel lands on top of a manual default group', () => {
+        const layout = moveChannel(base, 'a', 'default', 0, ['a', 'b']);
+        expect(shown(layout)).toEqual([['default', ['c', 'a', 'b']]]);
+    });
+
+    test('collapsed shows only unread and current channels', () => {
+        expect(shown(setGroupCollapsed(base, 'default', true))).toEqual([['default', ['a']]]);
+    });
+
+    test('collapsed hides unread DMs too', () => {
+        expect(allShown(setGroupCollapsed(base, 'dms', true))).toContainEqual(['dms', []]);
+    });
+
+    test('open DMs get their own group, closed ones stay out', () => {
+        expect(allShown(base)).toEqual([['default', ['b', 'c', 'a']], ['dms', ['dm1', 'dm2']]]);
+    });
+
+    test('sorts DMs A-Z by teammate name', () => {
+        expect(allShown(setGroupSorting(base, 'dms', 'alpha'))).toContainEqual(['dms', ['dm2', 'dm1']]);
+    });
+
+    test('a DM moved to a category leaves the DM group and returns when it is deleted', () => {
+        const layout = moveChannel(addGroup(base, 'g', 'Mine'), 'dm1', 'g', 0, []);
+        expect(allShown(layout)).toEqual([['g', ['dm1']], ['default', ['b', 'c', 'a']], ['dms', ['dm2']]]);
+        expect(allShown(deleteGroup(layout, 'g'))).toContainEqual(['dms', ['dm1', 'dm2']]);
+    });
+
+    test('a manual DM order survives and a new DM lands on top', () => {
+        const layout = moveChannel(base, 'dm2', 'dms', 0, ['dm2']);
+        expect(allShown(layout)).toContainEqual(['dms', ['dm1', 'dm2']]);
+    });
+
+    test('a layout saved before DMs gets the group', () => {
+        const old = JSON.stringify({groups: [{id: 'default', name: 'Channels', collapsed: false, sorting: 'manual', channelIds: ['a']}]});
+        expect(parseLayout(old).groups.map((g) => g.id)).toEqual(['default', 'dms']);
+    });
+
+    test('a drop into a collapsed category keeps its hidden channels', () => {
+        const layout = moveChannel({groups: [{...base.groups[0], channelIds: ['a', 'b']}]}, 'c', 'default', 0, ['a']);
+        expect(layout.groups[0].channelIds).toEqual(['c', 'a', 'b']);
+    });
+
+    test('deleting a category returns its channels, the default group stays', () => {
+        const layout = moveChannel(addGroup(base, 'g', 'Mine'), 'c', 'g', 0, []);
+        expect(shown(deleteGroup(layout, 'g'))).toEqual([['default', ['b', 'c', 'a']]]);
+        expect(deleteGroup(base, 'default')).toBe(base);
+        expect(deleteGroup(base, 'dms')).toBe(base);
+    });
+
+    test('reorders categories', () => {
+        expect(moveGroup(addGroup(base, 'g', 'Mine'), 'g', 1).groups.map((g) => g.id)).toEqual(['default', 'g', 'dms']);
+    });
+
+    test('corrupt storage falls back to the default layout', () => {
+        expect(parseLayout('{oops')).toEqual(base);
+        expect(parseLayout(null)).toEqual(base);
+        expect(parseLayout('{"groups":[]}')).toEqual(base);
+    });
+});
diff --git a/webapp/channels/src/selectors/views/all_teams.ts b/webapp/channels/src/selectors/views/all_teams.ts
new file mode 100644
index 00000000..c07cb2a7
--- /dev/null
+++ b/webapp/channels/src/selectors/views/all_teams.ts
@@ -0,0 +1,138 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): lays out the user's channels from every team, plus their DMs and GMs, into the
+// groups of the ALL pseudo-team.
+
+import type {ChannelCategory} from '@mattermost/types/channel_categories';
+import {CategorySorting} from '@mattermost/types/channel_categories';
+import type {Channel} from '@mattermost/types/channels';
+
+import {General} from 'mattermost-redux/constants';
+import {CategoryTypes} from 'mattermost-redux/constants/channel_categories';
+import {createSelector} from 'mattermost-redux/selectors/create_selector';
+import {makeFilterAndSortChannelsForCategory} from 'mattermost-redux/selectors/entities/channel_categories';
+import {getAllChannels, getAllDirectChannels, getChannelMessageCounts, getCurrentChannelId, getMyChannelMemberships} from 'mattermost-redux/selectors/entities/channels';
+import {getCurrentUserLocale} from 'mattermost-redux/selectors/entities/i18n';
+import {isCollapsedThreadsEnabled, shouldShowUnreadsCategory} from 'mattermost-redux/selectors/entities/preferences';
+import {calculateUnreadCount} from 'mattermost-redux/utils/channel_utils';
+
+import {DEFAULT_GROUP_ID, DM_GROUP_ID} from 'utils/all_teams_mode';
+import type {AllTeamsGroup, AllTeamsLayout} from 'utils/all_teams_mode';
+
+import type {GlobalState} from 'types/store';
+
+export type AllTeamsShownGroup = {
+    group: AllTeamsGroup;
+
+    // In display order. A collapsed group only shows the current channel.
+    shownIds: string[];
+};
+
+// Native filtering decides which DMs are open: the "direct messages" type also applies the limit on
+// how many stay visible, which natively spares DMs that were placed in a custom category.
+const DM_CATEGORY = {type: CategoryTypes.DIRECT_MESSAGES, sorting: CategorySorting.Recency} as ChannelCategory;
+const CUSTOM_CATEGORY = {type: CategoryTypes.CUSTOM, sorting: CategorySorting.Recency} as ChannelCategory;
+
+export function makeGetAllTeamsGroups(): (state: GlobalState, layout: AllTeamsLayout) => AllTeamsShownGroup[] {
+    const filterOpenDms = makeFilterAndSortChannelsForCategory();
+    const filterDmGroup = makeFilterAndSortChannelsForCategory();
+
+    const getMyDms = createSelector(
+        'getAllTeamsMyDms',
+        (state: GlobalState) => getAllDirectChannels(state),
+        (state: GlobalState) => getMyChannelMemberships(state),
+        (dms, myMembers) => dms.filter((dm) => Object.hasOwn(myMembers, dm.id)),
+    );
+
+    const getUnclaimedDms = createSelector(
+        'getAllTeamsUnclaimedDms',
+        (state: GlobalState) => getMyDms(state),
+        (_: GlobalState, layout: AllTeamsLayout) => layout,
+        (dms, layout) => {
+            const claimed = new Set(layout.groups.filter((group) => group.id !== DM_GROUP_ID).flatMap((group) => group.channelIds));
+            return dms.filter((dm) => !claimed.has(dm.id));
+        },
+    );
+
+    const getGroups = createSelector(
+        'getAllTeamsGroups',
+        (state: GlobalState) => getAllChannels(state),
+        (state: GlobalState) => getMyChannelMemberships(state),
+        (state: GlobalState) => getChannelMessageCounts(state),
+        (state: GlobalState) => getCurrentChannelId(state),
+        (state: GlobalState) => isCollapsedThreadsEnabled(state),
+        (state: GlobalState) => shouldShowUnreadsCategory(state),
+        (state: GlobalState) => getCurrentUserLocale(state),
+        (_: GlobalState, layout: AllTeamsLayout) => layout,
+        (_: GlobalState, _layout: AllTeamsLayout, openDms: Channel[]) => openDms,
+        (_: GlobalState, _layout: AllTeamsLayout, _openDms: Channel[], dmGroupDms: Channel[]) => dmGroupDms,
+        (allChannels, myMembers, messageCounts, currentChannelId, crtEnabled, unreadsFirst, locale, layout, openDms, dmGroupDms) => {
+            // DMs come with their display name filled in, which the raw channels don't have.
+            const channelsById: Record<string, Channel> = {...allChannels};
+            openDms.forEach((dm) => {
+                channelsById[dm.id] = dm;
+            });
+            const openDmIds = new Set(openDms.map((dm) => dm.id));
+            const dmGroupIds = dmGroupDms.map((dm) => dm.id);
+
+            const isListed = (channel?: Channel) => Boolean(
+                channel &&
+                (openDmIds.has(channel.id) || (
+                    (channel.type === General.OPEN_CHANNEL || channel.type === General.PRIVATE_CHANNEL) &&
+                    channel.team_id &&
+                    Object.hasOwn(myMembers, channel.id) &&
+                    (channel.delete_at === 0 || channel.id === currentChannelId)
+                )),
+            );
+            const isDm = (channel: Channel) => channel.type === General.DM_CHANNEL || channel.type === General.GM_CHANNEL;
+            const isUnread = (id: string) => calculateUnreadCount(messageCounts[id], myMembers[id], crtEnabled).showUnread;
+            const lastActivity = (channel: Channel) => Math.max(
+                crtEnabled ? (channel.last_root_post_at || channel.last_post_at) : channel.last_post_at,
+                channel.create_at,
+            );
+
+            const claimed = new Set(layout.groups.flatMap((group) => group.channelIds));
+            const unclaimed = Object.values(allChannels).
+                filter((channel) => !isDm(channel) && isListed(channel) && !claimed.has(channel.id)).
+                map((channel) => channel.id);
+
+            const getGroupIds = (group: AllTeamsGroup) => {
+                // New channels land on top of their built-in group, like in a native category.
+                if (group.id === DEFAULT_GROUP_ID) {
+                    return [...unclaimed, ...group.channelIds];
+                }
+                if (group.id === DM_GROUP_ID) {
+                    const placed = new Set(group.channelIds);
+                    return [...dmGroupIds.filter((id) => !placed.has(id)), ...group.channelIds.filter((id) => dmGroupIds.includes(id))];
+                }
+                return group.channelIds;
+            };
+
+            return layout.groups.map((group) => {
+                const channels = getGroupIds(group).map((id) => channelsById[id]).filter(isListed);
+
+                if (group.sorting !== 'manual') {
+                    channels.sort((a, b) => {
+                        if (unreadsFirst && isUnread(a.id) !== isUnread(b.id)) {
+                            return isUnread(a.id) ? -1 : 1;
+                        }
+                        if (group.sorting === 'alpha') {
+                            return a.display_name.localeCompare(b.display_name, locale, {numeric: true});
+                        }
+                        return lastActivity(b) - lastActivity(a);
+                    });
+                }
+
+                const shown = group.collapsed ? channels.filter((channel) => channel.id === currentChannelId) : channels;
+                return {group, shownIds: shown.map((channel) => channel.id)};
+            });
+        },
+    );
+
+    return (state: GlobalState, layout: AllTeamsLayout) => {
+        const openDms = filterOpenDms(state, getMyDms(state), CUSTOM_CATEGORY);
+        const dmGroupDms = filterDmGroup(state, getUnclaimedDms(state, layout), DM_CATEGORY);
+        return getGroups(state, layout, openDms, dmGroupDms);
+    };
+}
