@@ -0,0 +1,138 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {RequestStatus} from 'mattermost-redux/constants';
+
+import * as loginActions from 'actions/views/login';
+
+import Login from 'components/login/login';
+import {buildProxySsoUrl, extractDesktopServerToken} from 'components/login/proxy_sso_login';
+
+import {renderWithContext, screen, userEvent, waitFor} from 'tests/react_testing_utils';
+import {WindowSizes} from 'utils/constants';
+
+import type {GlobalState} from 'types/store';
+
+jest.unmock('react-intl');
+jest.unmock('react-router-dom');
+
+function makeProxyState(config: Record<string, string>) {
+    return {
+        entities: {
+            general: {
+                config,
+                license: {
+                    IsLicensed: 'true',
+                },
+            },
+            users: {
+                currentUserId: '',
+                profiles: {},
+            },
+            teams: {
+                currentTeamId: '',
+                teams: {},
+                myMembers: {},
+            },
+        },
+        requests: {
+            users: {
+                logout: {status: RequestStatus.NOT_STARTED},
+            },
+        },
+        storage: {
+            initialized: true,
+        },
+        views: {
+            browser: {windowSize: WindowSizes.DESKTOP_VIEW},
+        },
+    } as unknown as GlobalState;
+}
+
+describe('ProxySsoLogin', () => {
+    describe('extractDesktopServerToken', () => {
+        it('extracts server_token from https and mattermost URLs', () => {
+            expect(extractDesktopServerToken('https://chat.example/login/desktop?server_token=abc123&client_token=xyz')).toBe('abc123');
+            expect(extractDesktopServerToken('mattermost://chat.example/login/desktop?client_token=xyz&server_token=tok999')).toBe('tok999');
+            expect(extractDesktopServerToken('?server_token=onlyquery')).toBe('onlyquery');
+        });
+
+        it('accepts a raw token and rejects invalid inputs', () => {
+            expect(extractDesktopServerToken('  rawtoken123  ')).toBe('rawtoken123');
+            expect(extractDesktopServerToken('')).toBe('');
+            expect(extractDesktopServerToken('https://chat.example/login/desktop?client_token=xyz')).toBe('');
+            expect(extractDesktopServerToken('not a token')).toBe('');
+        });
+    });
+
+    describe('buildProxySsoUrl', () => {
+        it('points at the real upstream host with desktop_token', () => {
+            expect(buildProxySsoUrl('https://chat.example/', '/oauth/gitlab/login', 'abc')).toBe('https://chat.example/oauth/gitlab/login?desktop_token=abc');
+        });
+    });
+
+    describe('rendered in Login behind the local proxy', () => {
+        it('auto-detects standard SSO providers and submits the pasted desktop URL', async () => {
+            const openSpy = jest.spyOn(window, 'open').mockImplementation(() => null);
+            const loginSpy = jest.spyOn(loginActions, 'loginWithDesktopToken').mockReturnValue((() => Promise.resolve({error: {message: 'expired'}})) as never);
+
+            renderWithContext(<Login/>, makeProxyState({
+                ProxyUpstreamSiteURL: 'https://chat.example',
+                EnableSignInWithEmail: 'true',
+                EnableSignUpWithGitLab: 'true',
+                SiteName: 'Acme Chat',
+            }));
+
+            expect(screen.getByTestId('proxy-sso-login')).toBeVisible();
+            screen.getByRole('button', {name: /Open SSO on chat\.example/}).click();
+            expect(openSpy).toHaveBeenCalledWith(
+                expect.stringMatching(/^https:\/\/chat\.example\/oauth\/gitlab\/login\?desktop_token=[0-9a-f]{64}$/),
+                '_blank',
+                'noopener',
+            );
+
+            const input = screen.getByTestId('proxy-sso-token-input');
+            userEvent.type(input, 'https://chat.example/login/desktop?server_token=srv123&client_token=cli');
+            screen.getByRole('button', {name: 'Log in with token'}).click();
+
+            await waitFor(() => {
+                expect(loginSpy).toHaveBeenCalledWith('srv123');
+            });
+            expect(await screen.findByText(/The token was rejected or has expired/)).toBeVisible();
+
+            openSpy.mockRestore();
+            loginSpy.mockRestore();
+        });
+
+        it('renders custom providers configured via ProxySsoProviders', () => {
+            const openSpy = jest.spyOn(window, 'open').mockImplementation(() => null);
+
+            renderWithContext(<Login/>, makeProxyState({
+                ProxyUpstreamSiteURL: 'https://chat.example',
+                ProxySsoProviders: JSON.stringify([
+                    {label: 'Corp SSO', path: '/oauth/openid/login'},
+                    {label: 'Partner Login', path: '/oauth/partner/login'},
+                ]),
+                SiteName: 'Acme Chat',
+            }));
+
+            screen.getByRole('button', {name: 'Corp SSO'}).click();
+            expect(openSpy).toHaveBeenCalledWith(
+                expect.stringMatching(/^https:\/\/chat\.example\/oauth\/openid\/login\?desktop_token=[0-9a-f]{64}$/),
+                '_blank',
+                'noopener',
+            );
+
+            screen.getByRole('button', {name: 'Partner Login'}).click();
+            expect(openSpy).toHaveBeenLastCalledWith(
+                expect.stringMatching(/^https:\/\/chat\.example\/oauth\/partner\/login\?desktop_token=[0-9a-f]{64}$/),
+                '_blank',
+                'noopener',
+            );
+
+            openSpy.mockRestore();
+        });
+    });
+});
diff --git a/webapp/channels/src/components/login/proxy_sso_login.tsx b/webapp/channels/src/components/login/proxy_sso_login.tsx
new file mode 100644
index 00000000..eb57d45e
--- /dev/null
+++ b/webapp/channels/src/components/login/proxy_sso_login.tsx
@@ -0,0 +1,227 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React, {useRef, useState} from 'react';
+import type {FormEvent} from 'react';
+import {useIntl} from 'react-intl';
+import {useDispatch} from 'react-redux';
+
+import {loginWithDesktopToken} from 'actions/views/login';
+
+import AlertBanner from 'components/alert_banner';
+import SaveButton from 'components/save_button';
+import Input, {SIZE} from 'components/widgets/inputs/input/input';
+
+export type ProxySsoProvider = {
+    label: string;
+    path: string;
+};
+
+type Props = {
+    upstreamSiteUrl: string;
+    providers: ProxySsoProvider[];
+    onLogin: () => Promise<void>;
+    onInteraction?: () => void;
+};
+
+export function extractDesktopServerToken(raw: string): string {
+    const trimmed = raw.trim();
+    if (!trimmed) {
+        return '';
+    }
+    if (trimmed.includes('server_token=')) {
+        try {
+            const parsed = new URL(trimmed);
+            const token = parsed.searchParams.get('server_token');
+            if (token) {
+                return token.trim();
+            }
+        } catch {
+            // Fall through to query-string parsing for non-standard or partial URLs.
+        }
+        const queryStart = trimmed.indexOf('?');
+        const params = new URLSearchParams(queryStart >= 0 ? trimmed.slice(queryStart + 1) : trimmed);
+        return (params.get('server_token') ?? '').trim();
+    }
+    if (/[\s/?#]/.test(trimmed)) {
+        return '';
+    }
+    return trimmed;
+}
+
+export function generateDesktopClientToken(): string {
+    const bytes = new Uint8Array(32);
+    if (typeof window !== 'undefined' && window.crypto?.getRandomValues) {
+        window.crypto.getRandomValues(bytes);
+    } else {
+        for (let i = 0; i < bytes.length; i++) {
+            bytes[i] = Math.floor(Math.random() * 256);
+        }
+    }
+    return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export function buildProxySsoUrl(upstreamSiteUrl: string, oauthPath: string, desktopToken: string): string {
+    const base = upstreamSiteUrl.replace(/\/+$/, '');
+    return `${base}${oauthPath}?desktop_token=${encodeURIComponent(desktopToken)}`;
+}
+
+function hostOf(url: string): string {
+    try {
+        return new URL(url).host;
+    } catch {
+        return url;
+    }
+}
+
+const ProxySsoLogin: React.FC<Props> = ({upstreamSiteUrl, providers, onLogin, onInteraction}) => {
+    const {formatMessage} = useIntl();
+    const dispatch = useDispatch();
+    const inputRef = useRef<HTMLInputElement>(null);
+
+    const [tokenInput, setTokenInput] = useState('');
+    const [isWaiting, setIsWaiting] = useState(false);
+    const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+    const host = hostOf(upstreamSiteUrl);
+
+    const openSsoInBrowser = (oauthPath: string) => {
+        onInteraction?.();
+        setErrorMessage(null);
+        const url = buildProxySsoUrl(upstreamSiteUrl, oauthPath, generateDesktopClientToken());
+        window.open(url, '_blank', 'noopener');
+        inputRef.current?.focus();
+    };
+
+    const handleSubmit = async (e: FormEvent | React.MouseEvent) => {
+        e.preventDefault();
+        onInteraction?.();
+        setErrorMessage(null);
+
+        const rawValue = inputRef.current?.value ?? tokenInput;
+        const serverToken = extractDesktopServerToken(rawValue);
+        if (!serverToken) {
+            setErrorMessage(formatMessage({
+                id: 'login.proxy_sso.empty_token',
+                defaultMessage: 'Paste the final browser URL containing server_token=... or the token itself.',
+            }));
+            inputRef.current?.focus();
+            return;
+        }
+
+        setIsWaiting(true);
+        const {error: loginError} = await dispatch(loginWithDesktopToken(serverToken));
+        if (loginError) {
+            setIsWaiting(false);
+            setErrorMessage(formatMessage({
+                id: 'login.proxy_sso.invalid_token',
+                defaultMessage: 'The token was rejected or has expired. Open SSO again and paste the new URL.',
+            }));
+            inputRef.current?.focus();
+            return;
+        }
+
+        await onLogin();
+    };
+
+    return (
+        <div
+            className='login-body-card-proxy-sso'
+            data-testid='proxy-sso-login'
+        >
+            <p className='login-body-card-proxy-sso-hint'>
+                {formatMessage(
+                    {
+                        id: 'login.proxy_sso.hint',
+                        defaultMessage: 'Log in via {host} in your browser (no need to keep a second server in the app), then paste the final address bar URL with server_token=... below.',
+                    },
+                    {host},
+                )}
+            </p>
+            {providers.length > 0 && (
+                <div className='login-body-card-proxy-sso-buttons'>
+                    {providers.map((provider, index) => (
+                        <button
+                            key={`${provider.path}:${provider.label}`}
+                            type='button'
+                            className={index === 0 ? 'btn btn-primary login-body-card-proxy-sso-open' : 'btn btn-tertiary login-body-card-proxy-sso-secondary'}
+                            disabled={isWaiting}
+                            onClick={() => openSsoInBrowser(provider.path)}
+                        >
+                            {providers.length === 1
+                                ? formatMessage(
+                                    {
+                                        id: 'login.proxy_sso.open_button',
+                                        defaultMessage: '1. Open SSO on {host}',
+                                    },
+                                    {host},
+                                )
+                                : provider.label}
+                        </button>
+                    ))}
+                </div>
+            )}
+            {errorMessage && (
+                <AlertBanner
+                    id='proxy-sso-error-banner'
+                    className='login-body-card-proxy-sso-banner'
+                    mode='danger'
+                    title={errorMessage}
+                    onDismiss={() => setErrorMessage(null)}
+                />
+            )}
+            <form
+                className='login-body-card-proxy-sso-form'
+                onSubmit={handleSubmit}
+            >
+                <Input
+                    data-testid='proxy-sso-token-input'
+                    ref={inputRef}
+                    name='proxyDesktopToken'
+                    containerClassName='login-body-card-proxy-sso-input'
+                    type='text'
+                    inputSize={SIZE.LARGE}
+                    value={tokenInput}
+                    onChange={(e: React.ChangeEvent<HTMLInputElement>) => {
+                        setTokenInput(e.target.value);
+                        if (errorMessage) {
+                            setErrorMessage(null);
+                        }
+                    }}
+                    hasError={Boolean(errorMessage)}
+                    placeholder={formatMessage(
+                        {
+                            id: 'login.proxy_sso.placeholder',
+                            defaultMessage: '2. Paste {host}/login/desktop?server_token=... or token',
+                        },
+                        {host},
+                    )}
+                    disabled={isWaiting}
+                />
+                <SaveButton
+                    extraClasses='login-body-card-proxy-sso-submit large'
+                    saving={isWaiting}
+                    onClick={handleSubmit}
+                    defaultMessage={formatMessage({
+                        id: 'login.proxy_sso.submit',
+                        defaultMessage: 'Log in with token',
+                    })}
+                    savingMessage={formatMessage({
+                        id: 'login.logingIn',
+                        defaultMessage: 'Logging in…',
+                    })}
+                />
+            </form>
+            <div className='login-body-card-proxy-sso-footer'>
+                <a href='/__auth'>
+                    {formatMessage({
+                        id: 'login.proxy_sso.fallback_link',
+                        defaultMessage: 'Bookmarklet / manual cookie paste (/__auth)',
+                    })}
+                </a>
+            </div>
+        </div>
+    );
+};
+
+export default ProxySsoLogin;
