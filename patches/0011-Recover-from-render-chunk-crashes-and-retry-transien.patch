+const PERMALINK_RETRY_DELAYS_MS = [300, 800];
+
+function isTransientPermalinkError(error: unknown): boolean {
+    if (!error || typeof error !== 'object') {
+        return true;
+    }
+    const status = (error as {status_code?: number}).status_code;
+    return status === undefined || status === 0 || status >= 500;
+}
+
+function sleep(ms: number): Promise<void> {
+    return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function fetchPostInfoWithRetry(postId: string) {
+    let lastError: unknown;
+    for (let attempt = 0; attempt <= PERMALINK_RETRY_DELAYS_MS.length; attempt++) {
+        try {
+            return await Client4.getPostInfo(postId);
+        } catch (error) {
+            lastError = error;
+            if (attempt >= PERMALINK_RETRY_DELAYS_MS.length || !isTransientPermalinkError(error)) {
+                throw error;
+            }
+            await sleep(PERMALINK_RETRY_DELAYS_MS[attempt]);
+        }
+    }
+    throw lastError;
+}
