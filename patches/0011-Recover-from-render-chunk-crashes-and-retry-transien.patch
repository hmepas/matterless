@@ -0,0 +1,205 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): catches render and lazy-chunk failures so the app never freezes on a white screen.
+
+import React from 'react';
+
+import {getHistory} from 'utils/browser_history';
+import {isChunkLoadError, reportClientError, tryReloadOnceForChunkError} from 'utils/crash_recovery';
+
+type Props = {
+    children: React.ReactNode;
+    componentName?: string;
+    fullPage?: boolean;
+};
+
+type State = {
+    error: Error | null;
+    reloading: boolean;
+};
+
+const containerStyle: React.CSSProperties = {
+    display: 'flex',
+    alignItems: 'center',
+    justifyContent: 'center',
+    padding: '32px 16px',
+    width: '100%',
+    height: '100%',
+    minHeight: '200px',
+    boxSizing: 'border-box',
+    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
+    color: '#222',
+    backgroundColor: '#fff',
+};
+
+const cardStyle: React.CSSProperties = {
+    maxWidth: '420px',
+    width: '100%',
+    padding: '20px 24px',
+    border: '1px solid #d9dce1',
+    borderRadius: '8px',
+    backgroundColor: '#fff',
+    boxShadow: '0 2px 10px rgba(0, 0, 0, 0.06)',
+};
+
+const titleStyle: React.CSSProperties = {
+    margin: '0 0 8px',
+    fontSize: '16px',
+    fontWeight: 600,
+};
+
+const textStyle: React.CSSProperties = {
+    margin: '0 0 16px',
+    fontSize: '13px',
+    lineHeight: 1.5,
+    color: '#555',
+};
+
+const actionsStyle: React.CSSProperties = {
+    display: 'flex',
+    gap: '8px',
+    flexWrap: 'wrap',
+};
+
+const primaryButtonStyle: React.CSSProperties = {
+    padding: '7px 14px',
+    fontSize: '13px',
+    fontWeight: 600,
+    color: '#fff',
+    backgroundColor: '#1c58d9',
+    border: 'none',
+    borderRadius: '4px',
+    cursor: 'pointer',
+};
+
+const secondaryButtonStyle: React.CSSProperties = {
+    padding: '7px 14px',
+    fontSize: '13px',
+    fontWeight: 600,
+    color: '#1c58d9',
+    backgroundColor: 'transparent',
+    border: '1px solid #1c58d9',
+    borderRadius: '4px',
+    cursor: 'pointer',
+};
+
+export default class AppErrorBoundary extends React.PureComponent<Props, State> {
+    private unlistenHistory?: () => void;
+
+    state: State = {
+        error: null,
+        reloading: false,
+    };
+
+    static getDerivedStateFromError(error: Error): Partial<State> {
+        return {error};
+    }
+
+    componentDidMount() {
+        try {
+            const history = getHistory();
+            if (history && typeof history.listen === 'function') {
+                this.unlistenHistory = history.listen(() => {
+                    if (this.state.error && !this.state.reloading) {
+                        this.setState({error: null});
+                    }
+                });
+            }
+        } catch {
+            // History may not be initialized in isolated unit tests.
+        }
+    }
+
+    componentWillUnmount() {
+        this.unlistenHistory?.();
+    }
+
+    componentDidCatch(error: Error) {
+        const chunkError = isChunkLoadError(error);
+        reportClientError(chunkError ? 'chunk_load_error' : 'react_crash', error, {
+            component: this.props.componentName || 'App',
+        });
+
+        if (chunkError && tryReloadOnceForChunkError()) {
+            this.setState({reloading: true});
+        }
+    }
+
+    handleRetry = () => {
+        this.setState({error: null, reloading: false});
+    };
+
+    handleReload = () => {
+        window.location.reload();
+    };
+
+    handleGoHome = () => {
+        try {
+            getHistory().push('/');
+        } catch {
+            window.location.assign('/');
+            return;
+        }
+        this.setState({error: null, reloading: false});
+    };
+
+    render() {
+        if (!this.state.error) {
+            return this.props.children;
+        }
+
+        const isChunk = isChunkLoadError(this.state.error);
+        const wrapperStyle: React.CSSProperties = this.props.fullPage ? {...containerStyle, minHeight: '100vh'} : containerStyle;
+
+        return (
+            <div
+                style={wrapperStyle}
+                role='alert'
+                data-testid='app-error-boundary'
+            >
+                <div style={cardStyle}>
+                    <h3 style={titleStyle}>
+                        {this.state.reloading ? 'Обновление приложения…' : 'Не удалось отобразить экран'}
+                    </h3>
+                    <p style={textStyle}>
+                        {this.state.reloading ?
+                            'Загружаем актуальную версию интерфейса…' :
+                            (isChunk ?
+                                'Часть интерфейса не загрузилась (возможно, обновилась сборка или пропала связь).' :
+                                'Произошла ошибка интерфейса. Можно попробовать снова или перезагрузить страницу.')}
+                    </p>
+                    {!this.state.reloading && (
+                        <div style={actionsStyle}>
+                            {!isChunk && (
+                                <button
+                                    type='button'
+                                    style={primaryButtonStyle}
+                                    onClick={this.handleRetry}
+                                >
+                                    {'Повторить'}
+                                </button>
+                            )}
+                            <button
+                                type='button'
+                                style={isChunk ? primaryButtonStyle : secondaryButtonStyle}
+                                onClick={this.handleReload}
+                            >
+                                {'Перезагрузить'}
+                            </button>
+                            {this.props.fullPage && (
+                                <button
+                                    type='button'
+                                    style={secondaryButtonStyle}
+                                    onClick={this.handleGoHome}
+                                >
+                                    {'На главную'}
+                                </button>
+                            )}
+                        </div>
+                    )}
+                </div>
+            </div>
+        );
+    }
+}
