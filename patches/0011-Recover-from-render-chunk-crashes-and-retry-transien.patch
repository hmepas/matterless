index 00000000..699a2a89
--- /dev/null
+++ b/webapp/channels/src/utils/crash_recovery.test.ts
@@ -0,0 +1,65 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {
+    formatErrorSummary,
+    isChunkLoadError,
+    reportClientError,
+    resetCrashRecoveryForTests,
+    tryReloadOnceForChunkError,
+} from './crash_recovery';
+
+describe('utils/crash_recovery', () => {
+    const originalFetch = global.fetch;
+
+    beforeEach(() => {
+        resetCrashRecoveryForTests();
+        global.fetch = jest.fn(() => Promise.resolve({ok: true} as Response));
+    });
+
+    afterAll(() => {
+        global.fetch = originalFetch;
+    });
+
+    test('identifies webpack and dynamic import chunk load errors', () => {
+        const chunkErr = new Error('Loading chunk 1300 failed.');
+        chunkErr.name = 'ChunkLoadError';
+        expect(isChunkLoadError(chunkErr)).toBe(true);
+        expect(isChunkLoadError(new Error('Loading CSS chunk 1660 failed.'))).toBe(true);
+        expect(isChunkLoadError(new Error('Failed to fetch dynamically imported module: /static/x.js'))).toBe(true);
+        expect(isChunkLoadError(new TypeError('Cannot read properties of undefined'))).toBe(false);
+    });
+
+    test('reports safe metadata to /__client_log and deduplicates bursts', () => {
+        const err = new TypeError('boom');
+        reportClientError('react_crash', err, {component: 'PermalinkView', route: '/team/pl/abc'});
+        reportClientError('react_crash', err, {component: 'PermalinkView', route: '/team/pl/abc'});
+
+        expect(global.fetch).toHaveBeenCalledTimes(1);
+        const [url, init] = (global.fetch as jest.Mock).mock.calls[0];
+        expect(url).toBe('/__client_log');
+        expect(JSON.parse(init.body)).toMatchObject({
+            event: 'react_crash',
+            component: 'PermalinkView',
+            error: 'TypeError:boom',
+            route: '/team/pl/abc',
+        });
+    });
+
+    test('formats non-Error objects without crashing', () => {
+        expect(formatErrorSummary({status_code: 502, server_error_id: 'bad_gateway'})).toBe('bad_gateway:502');
+        expect(formatErrorSummary(null)).toBe('unknown');
+    });
+
+    test('auto-reloads once on chunk errors and respects the cooldown window', () => {
+        const reload = jest.fn();
+        expect(tryReloadOnceForChunkError(100000, reload)).toBe(true);
+        expect(reload).toHaveBeenCalledTimes(1);
+
+        expect(tryReloadOnceForChunkError(105000, reload)).toBe(false);
+        expect(reload).toHaveBeenCalledTimes(1);
+
+        expect(tryReloadOnceForChunkError(135000, reload)).toBe(true);
+        expect(reload).toHaveBeenCalledTimes(2);
+    });
+});
diff --git a/webapp/channels/src/utils/crash_recovery.ts b/webapp/channels/src/utils/crash_recovery.ts
new file mode 100644
index 00000000..8ab8cb4f
--- /dev/null
+++ b/webapp/channels/src/utils/crash_recovery.ts
@@ -0,0 +1,105 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+// PATCH(all-teams): prevents uncaught React or chunk-load errors from leaving a silent white screen,
+// and reports safe diagnostic metadata to the local proxy log.
+
+const CHUNK_RELOAD_KEY = 'mm_chunk_reload_at';
+const CHUNK_RELOAD_COOLDOWN_MS = 30000;
+const ERROR_DEDUP_MS = 10000;
+
+const recentErrors = new Map<string, number>();
+
+export function isChunkLoadError(error: unknown): boolean {
+    if (!error) {
+        return false;
+    }
+    const name = typeof error === 'object' && 'name' in error ? String((error as {name?: unknown}).name ?? '') : '';
+    const message = typeof error === 'object' && 'message' in error ? String((error as {message?: unknown}).message ?? '') : String(error);
+    return (
+        name === 'ChunkLoadError' ||
+        (/Loading (?:CSS )?chunk [\w-]+ failed/i).test(message) ||
+        (/Failed to fetch dynamically imported module/i).test(message)
+    );
+}
+
+export function formatErrorSummary(error: unknown): string {
+    if (!error) {
+        return 'unknown';
+    }
+    if (error instanceof Error) {
+        const summary = error.message ? `${error.name}:${error.message}` : error.name;
+        return summary.slice(0, 140);
+    }
+    if (typeof error === 'object') {
+        const obj = error as {name?: unknown; message?: unknown; status_code?: unknown; server_error_id?: unknown};
+        const parts = [obj.name, obj.server_error_id, obj.status_code, obj.message].filter((v) => v !== undefined && v !== '');
+        if (parts.length > 0) {
+            return parts.map(String).join(':').slice(0, 140);
+        }
+    }
+    return String(error).slice(0, 140);
+}
+
+export function reportClientError(
+    event: string,
+    error: unknown,
+    details: {component?: string; route?: string} = {},
+): void {
+    const summary = formatErrorSummary(error);
+    const component = details.component ?? '';
+    const route = details.route ?? (typeof window !== 'undefined' ? window.location.pathname : '');
+    const key = `${event}|${component}|${summary}`;
+    const now = Date.now();
+    const last = recentErrors.get(key);
+    if (last !== undefined && now - last < ERROR_DEDUP_MS) {
+        return;
+    }
+    recentErrors.set(key, now);
+
+    if (typeof fetch !== 'function') {
+        return;
+    }
+    fetch('/__client_log', {
+        method: 'POST',
+        headers: {'Content-Type': 'application/json'},
+        keepalive: true,
+        body: JSON.stringify({
+            event,
+            component,
+            error: summary,
+            route,
+            online: typeof navigator !== 'undefined' ? navigator.onLine : true,
+        }),
+    }).catch(() => {
+        // Diagnostic logging must never break error recovery.
+    });
+}
+
+export function tryReloadOnceForChunkError(
+    now: number = Date.now(),
+    reload: () => void = () => window.location.reload(),
+): boolean {
+    try {
+        const lastRaw = window.sessionStorage.getItem(CHUNK_RELOAD_KEY);
+        const last = lastRaw ? Number(lastRaw) : 0;
+        if (last && now - last < CHUNK_RELOAD_COOLDOWN_MS) {
+            return false;
+        }
+        window.sessionStorage.setItem(CHUNK_RELOAD_KEY, String(now));
+    } catch {
+        // If sessionStorage is unavailable, avoid risking a reload loop.
+        return false;
+    }
+    reload();
+    return true;
+}
+
+export function resetCrashRecoveryForTests(): void {
+    recentErrors.clear();
+    try {
+        window.sessionStorage.removeItem(CHUNK_RELOAD_KEY);
+    } catch {
+        // Ignore.
+    }
+}
