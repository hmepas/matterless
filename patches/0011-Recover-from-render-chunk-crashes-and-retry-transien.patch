@@ -0,0 +1,89 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import {fireEvent, render, screen} from 'tests/react_testing_utils';
+import * as CrashRecovery from 'utils/crash_recovery';
+
+import AppErrorBoundary from './app_error_boundary';
+
+function Thrower({error}: {error: Error | null}) {
+    if (error) {
+        throw error;
+    }
+    return <div>{'ok'}</div>;
+}
+
+describe('components/AppErrorBoundary', () => {
+    let consoleErrorSpy: jest.SpyInstance;
+
+    beforeEach(() => {
+        CrashRecovery.resetCrashRecoveryForTests();
+        consoleErrorSpy = jest.spyOn(console, 'error').mockImplementation(() => {});
+    });
+
+    afterEach(() => {
+        consoleErrorSpy.mockRestore();
+        jest.restoreAllMocks();
+    });
+
+    test('catches render errors, reports them, and recovers on Retry', () => {
+        const reportSpy = jest.spyOn(CrashRecovery, 'reportClientError').mockImplementation(() => {});
+        let shouldThrow = true;
+
+        function Flaky() {
+            if (shouldThrow) {
+                throw new Error('render exploded');
+            }
+            return <div>{'recovered'}</div>;
+        }
+
+        render(
+            <AppErrorBoundary componentName='PermalinkView'>
+                <Flaky/>
+            </AppErrorBoundary>,
+        );
+
+        expect(screen.getByTestId('app-error-boundary')).toBeInTheDocument();
+        expect(reportSpy).toHaveBeenCalledWith('react_crash', expect.any(Error), {component: 'PermalinkView'});
+
+        shouldThrow = false;
+        fireEvent.click(screen.getByRole('button', {name: 'Повторить'}));
+        expect(screen.getByText('recovered')).toBeInTheDocument();
+    });
+
+    test('triggers a guarded reload on ChunkLoadError', () => {
+        const reportSpy = jest.spyOn(CrashRecovery, 'reportClientError').mockImplementation(() => {});
+        const reloadSpy = jest.spyOn(CrashRecovery, 'tryReloadOnceForChunkError').mockReturnValue(true);
+
+        const chunkErr = new Error('Loading chunk 1300 failed.');
+        chunkErr.name = 'ChunkLoadError';
+
+        render(
+            <AppErrorBoundary componentName='PermalinkView'>
+                <Thrower error={chunkErr}/>
+            </AppErrorBoundary>,
+        );
+
+        expect(reportSpy).toHaveBeenCalledWith('chunk_load_error', chunkErr, {component: 'PermalinkView'});
+        expect(reloadSpy).toHaveBeenCalledTimes(1);
+        expect(screen.getByText('Обновление приложения…')).toBeInTheDocument();
+    });
+
+    test('shows a manual Reload button when auto-reload was already attempted', () => {
+        jest.spyOn(CrashRecovery, 'reportClientError').mockImplementation(() => {});
+        jest.spyOn(CrashRecovery, 'tryReloadOnceForChunkError').mockReturnValue(false);
+
+        const chunkErr = new Error('Loading chunk 1300 failed.');
+        chunkErr.name = 'ChunkLoadError';
+
+        render(
+            <AppErrorBoundary componentName='PermalinkView'>
+                <Thrower error={chunkErr}/>
+            </AppErrorBoundary>,
+        );
+
+        expect(screen.getByRole('button', {name: 'Перезагрузить'})).toBeInTheDocument();
+    });
+});
diff --git a/webapp/channels/src/components/app_error_boundary.tsx b/webapp/channels/src/components/app_error_boundary.tsx
new file mode 100644
index 00000000..9eee6cb5
--- /dev/null
