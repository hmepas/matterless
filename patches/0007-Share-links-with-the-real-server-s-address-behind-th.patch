+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import {getConfig} from 'mattermost-redux/selectors/entities/general';
+
+import store from 'stores/redux_store';
+
+import {getSiteURL} from 'utils/url';
+
+// When the webapp is served by a local proxy, getSiteURL() is the proxy's address, which nobody
+// else can open. The proxy reports the real server in ProxyUpstreamSiteURL: links that leave
+// this webapp (copied, forwarded, sent) use it, and links to it that come in are opened here.
+export function getPublicSiteURL(): string {
+    const config = getConfig(store.getState()) as {ProxyUpstreamSiteURL?: string};
+    return config.ProxyUpstreamSiteURL?.replace(/\/+$/, '') || getSiteURL();
+}
+
+export function toPublicURL(url: string): string {
+    return replacePrefix(url, getSiteURL(), getPublicSiteURL());
+}
+
+export function toLocalURL(url: string): string {
+    return replacePrefix(url, getPublicSiteURL(), getSiteURL());
+}
+
+function replacePrefix(url: string, from: string, to: string): string {
+    if (from === to || !url.startsWith(from)) {
+        return url;
+    }
+    const rest = url.substring(from.length);
+    if (rest && !(/^[/?#]/).test(rest)) {
+        return url;
+    }
+    return to + rest;
+}
