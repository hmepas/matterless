diff --git a/webapp/channels/src/utils/public_site_url.test.ts b/webapp/channels/src/utils/public_site_url.test.ts
new file mode 100644
index 00000000..7fc3a06f
--- /dev/null
+++ b/webapp/channels/src/utils/public_site_url.test.ts
@@ -0,0 +1,167 @@
+// Copyright (c) 2015-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import fs from 'fs';
+import path from 'path';
+
+import type {ChannelBookmark} from '@mattermost/types/channel_bookmarks';
+import type {Channel} from '@mattermost/types/channels';
+import type {Post} from '@mattermost/types/posts';
+
+import * as PostActions from 'mattermost-redux/actions/posts';
+import {Client4} from 'mattermost-redux/client';
+
+import {forwardPost} from 'actions/views/posts';
+
+import {copyBookmarkLink, shouldOpenBookmarkInNewTab} from 'components/channel_bookmarks/utils';
+
+import {format} from 'utils/markdown';
+import {copyToClipboard} from 'utils/utils';
+
+import type {GlobalState} from 'types/store';
+
+import {getPublicSiteURL, toLocalURL, toPublicURL} from './public_site_url';
+
+// jsdom serves the tests from the address of the local proxy.
+const PROXY = 'http://localhost:8065';
+const REAL = 'https://chat.example';
+
+let config: Record<string, string> = {};
+const state = () => ({
+    entities: {
+        general: {config, license: {}},
+        users: {currentUserId: 'me', profiles: {}},
+        teams: {currentTeamId: 't1', teams: {t1: {id: 't1', name: 'acme'}}, myMembers: {}},
+        channels: {channels: {}, myMembers: {}, roles: {}},
+        roles: {roles: {}},
+        preferences: {myPreferences: {}},
+        groups: {groups: {}, syncables: {}, myGroups: []},
+    },
+    plugins: {components: {}},
+}) as unknown as GlobalState;
+
+jest.mock('stores/redux_store', () => ({getState: () => state(), dispatch: jest.fn(), subscribe: jest.fn()}));
+jest.mock('utils/utils', () => ({...jest.requireActual('utils/utils'), copyToClipboard: jest.fn()}));
+
+const behindProxy = () => {
+    config = {SiteURL: PROXY, ProxyUpstreamSiteURL: REAL};
+};
+
+describe('links behind the local proxy', () => {
+    beforeEach(() => {
+        config = {};
+        jest.clearAllMocks();
+    });
+
+    describe('site URL', () => {
+        test('without the proxy, the public site URL is the local one', () => {
+            expect(getPublicSiteURL()).toBe(PROXY);
+            expect(toPublicURL(`${PROXY}/acme/pl/abc`)).toBe(`${PROXY}/acme/pl/abc`);
+            expect(toLocalURL(`${REAL}/acme/pl/abc`)).toBe(`${REAL}/acme/pl/abc`);
+        });
+
+        test('behind the proxy, the public site URL is the real server', () => {
+            behindProxy();
+            expect(getPublicSiteURL()).toBe(REAL);
+        });
+
+        test('a trailing slash of the real server address is dropped', () => {
+            config = {ProxyUpstreamSiteURL: `${REAL}/`};
+            expect(getPublicSiteURL()).toBe(REAL);
+        });
+    });
+
+    describe('outgoing links', () => {
+        beforeEach(behindProxy);
+
+        test('a proxy link is turned into a real server link', () => {
+            expect(toPublicURL(`${PROXY}/acme/pl/abc`)).toBe(`${REAL}/acme/pl/abc`);
+            expect(toPublicURL(PROXY)).toBe(REAL);
+            expect(toPublicURL(`${PROXY}?x=1`)).toBe(`${REAL}?x=1`);
+        });
+
+        test('foreign links and look-alike hosts are kept', () => {
+            expect(toPublicURL('https://example.org/acme/pl/abc')).toBe('https://example.org/acme/pl/abc');
+            expect(toPublicURL(`${PROXY}0/acme/pl/abc`)).toBe(`${PROXY}0/acme/pl/abc`);
+        });
+
+        test('forwarding a post sends a real server permalink', async () => {
+            const createPost = jest.spyOn(PostActions, 'createPost').mockReturnValue((() => ({data: true})) as never);
+            const post = {id: 'p1', channel_id: 'from'} as Post;
+            const channel = {id: 'to', team_id: 't1', type: 'O'} as Channel;
+            const dispatch: jest.Mock = jest.fn((action): unknown => (typeof action === 'function' ? action(dispatch, state) : action));
+
+            await forwardPost(post, channel, 'look')(dispatch, state, {} as never);
+
+            expect(createPost.mock.calls[0][0].message).toBe(`look\n${REAL}/acme/pl/p1`);
+        });
+
+        test('copying the link of a file bookmark copies a real server link', () => {
+            Client4.setUrl(PROXY); // as root.tsx does on start
+            copyBookmarkLink({type: 'file', file_id: 'f1'} as ChannelBookmark);
+            expect(copyToClipboard).toHaveBeenCalledWith(`${REAL}/api/v4/files/f1?download=1`);
+        });
+
+        test('copying the link of a link bookmark copies it as is', () => {
+            copyBookmarkLink({type: 'link', link_url: `${REAL}/acme/channels/town-square`} as ChannelBookmark);
+            expect(copyToClipboard).toHaveBeenCalledWith(`${REAL}/acme/channels/town-square`);
+        });
+
+        // These build a shared link from one getPublicSiteURL() call each: guard against a rebase
