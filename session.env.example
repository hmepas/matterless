# cp session.env.example session.env && chmod 600 session.env
MM_SERVICESETTINGS_SITEURL=https://mattermost.example.com

# Optional: custom SSO buttons for /login and /__auth (comma-separated Label=/path).
# When unset, standard Mattermost SSO providers (GitLab, Google, OpenID, Office365, SAML)
# are auto-detected from the server's client config.
# MM_PROXY_SSO_PROVIDERS=SSO=/oauth/openid/login,GitLab=/oauth/gitlab/login

# Optional manual fallback: real server tab -> DevTools -> Application -> Cookies.
# Normally leave empty and sign in via /login or /__auth (saved automatically to session.json).
MM_SESSION_TOKEN=
MM_SESSION_USERID=
MM_SESSION_CSRF=
